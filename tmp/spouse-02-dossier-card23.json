[
  {
    "key": "a|dossier-2.a.q1|early",
    "variants": [
      {
        "id": "a|dossier-2.a.q1|early#1",
        "text": "익명 글이 외부 소문이 아니라고 본 건 학교 회신의 문구가 제가 아는 내부 흐름과 맞았기 때문입니다.",
        "behaviorHint": "조심스럽게 내부 유출 쪽으로 판단한다."
      },
      {
        "id": "a|dossier-2.a.q1|early#2",
        "text": "학교 회신의 발신 흔적과 집 안에서 본 초안이 이어져 있었고, 그때 외부 소문은 아니라고 봤습니다.",
        "behaviorHint": "확인된 흔적부터 차례로 말한다."
      },
      {
        "id": "a|dossier-2.a.q1|early#3",
        "text": "학교가 받은 메일 경로와 제가 본 자료가 같은 선상에 있었기에 내부 유출이라고 판단했습니다.",
        "behaviorHint": "내부 경로를 짚되 단정은 늦춘다."
      }
    ]
  },
  {
    "key": "a|dossier-2.a.q1|mid",
    "variants": [
      {
        "id": "a|dossier-2.a.q1|mid#1",
        "text": "학교 회신의 헤더와 복합기 기록이 함께 움직여서 외부 소문으로는 설명이 안 됐습니다.",
        "behaviorHint": "근거를 두 개 이상 묶어 말한다."
      },
      {
        "id": "a|dossier-2.a.q1|mid#2",
        "text": "보조 계정과 스캔본 해시가 연결된 순간, 저는 누군가 안에서 정보를 흘렸다고 봤습니다.",
        "behaviorHint": "연결 경로를 더 분명하게 짚는다."
      },
      {
        "id": "a|dossier-2.a.q1|mid#3",
        "text": "외부 글로 보기엔 회신 경로가 너무 정확했고, 집 안 기록과도 맞아떨어졌습니다.",
        "behaviorHint": "의심이 생긴 근거를 간결하게 정리한다."
      }
    ]
  },
  {
    "key": "a|dossier-2.a.q1|late",
    "variants": [
      {
        "id": "a|dossier-2.a.q1|late#1",
        "text": "학교 회신의 헤더, 스캔본 해시, 보조 계정 로그가 한 흐름으로 이어졌습니다.",
        "behaviorHint": "핵심 증거를 한 번에 정리한다."
      },
      {
        "id": "a|dossier-2.a.q1|late#2",
        "text": "그 세 가지만 맞춰도 익명 소문이 아니라 내부 유출이라는 결론밖에 남지 않습니다.",
        "behaviorHint": "결론을 분명히 말한다."
      },
      {
        "id": "a|dossier-2.a.q1|late#3",
        "text": "저는 그 순간부터 누가 외부가 아니라 내부에서 건드렸는지 확인하게 됐습니다.",
        "behaviorHint": "판단의 전환점을 분명히 밝힌다."
      }
    ]
  },
  {
    "key": "a|dossier-2.a.q2|early",
    "variants": [
      {
        "id": "a|dossier-2.a.q2|early#1",
        "text": "학교 회신을 보고 도윤 씨 보조 계정과 집 안 복합기 쪽을 먼저 의심했습니다.",
        "behaviorHint": "조심스럽게 연결 대상을 말한다."
      },
      {
        "id": "a|dossier-2.a.q2|early#2",
        "text": "회신 문구가 너무 내부적이라, 저는 제 남편 쪽 경로를 떠올릴 수밖에 없었습니다.",
        "behaviorHint": "감정은 낮추고 추론만 말한다."
      },
      {
        "id": "a|dossier-2.a.q2|early#3",
        "text": "학교 답변과 제가 본 자료가 같은 방향으로 움직여서 남편 쪽 연결이라고 봤습니다.",
        "behaviorHint": "판단의 방향을 짧게 설명한다."
      }
    ]
  },
  {
    "key": "a|dossier-2.a.q2|mid",
    "variants": [
      {
        "id": "a|dossier-2.a.q2|mid#1",
        "text": "회신 헤더가 도윤 씨 쪽 이메일과 이어져 보였고, 복합기 기록도 맞물렸습니다.",
        "behaviorHint": "증거 간 연결을 선명하게 말한다."
      },
      {
        "id": "a|dossier-2.a.q2|mid#2",
        "text": "보조 메일 주소와 학교가 받은 회신 경로가 겹쳤고, 그때 내부 연결이라고 판단했습니다.",
        "behaviorHint": "경로 중심으로 설명한다."
      },
      {
        "id": "a|dossier-2.a.q2|mid#3",
        "text": "학교 답변을 보자마자 집 안 스캔본과 연결된 흔적이 떠올랐습니다.",
        "behaviorHint": "직접 본 흔적을 우선시한다."
      }
    ]
  },
  {
    "key": "a|dossier-2.a.q2|late",
    "variants": [
      {
        "id": "a|dossier-2.a.q2|late#1",
        "text": "학교 회신의 발신 경로와 첨부 해시가 도윤 씨가 쓴 보조 이메일과 집 안 복합기 기록으로 이어졌습니다.",
        "behaviorHint": "연결 고리를 구체적으로 밝힌다."
      },
      {
        "id": "a|dossier-2.a.q2|late#2",
        "text": "저는 그 자료를 보고 남편 쪽 계정과 스캔 경로를 한 번에 의심했습니다.",
        "behaviorHint": "의심의 대상과 이유를 함께 말한다."
      },
      {
        "id": "a|dossier-2.a.q2|late#3",
        "text": "학교가 받은 회신은 단순한 외부 제보가 아니라 집 안 기록과 맞물린 경로였습니다.",
        "behaviorHint": "최종 판단을 단정적으로 말한다."
      }
    ]
  },
  {
    "key": "a|dossier-2.a.q3|early",
    "variants": [
      {
        "id": "a|dossier-2.a.q3|early#1",
        "text": "아이보다 제 과거가 먼저 떠올랐다는 점이 가장 크게 무너진 지점입니다.",
        "behaviorHint": "수치심보다 충격을 먼저 말한다."
      },
      {
        "id": "a|dossier-2.a.q3|early#2",
        "text": "제 상담 기록이 아이 앞에서 알려질까 봐, 그때 제 마음이 가장 크게 꺾였습니다.",
        "behaviorHint": "두려움의 방향을 분명히 한다."
      },
      {
        "id": "a|dossier-2.a.q3|early#3",
        "text": "제가 엄마로 보이는 모습보다 과거 기록이 먼저 따라붙는 느낌이 너무 컸습니다.",
        "behaviorHint": "체면이 무너진 감정을 조심스럽게 말한다."
      }
    ]
  },
  {
    "key": "a|dossier-2.a.q3|mid",
    "variants": [
      {
        "id": "a|dossier-2.a.q3|mid#1",
        "text": "제 상담 기록이 엄마 자격 전체로 번져 버릴까 두려웠습니다.",
        "behaviorHint": "불안의 핵심을 짚는다."
      },
      {
        "id": "a|dossier-2.a.q3|mid#2",
        "text": "아이를 지키려던 마음보다 제 과거가 학교에 퍼지는 공포가 먼저 왔습니다.",
        "behaviorHint": "감정의 순서를 분명히 한다."
      },
      {
        "id": "a|dossier-2.a.q3|mid#3",
        "text": "제가 숨기고 싶었던 건 과거 자체보다, 그게 양육 판단으로 읽히는 일이었습니다.",
        "behaviorHint": "오해의 축을 설명한다."
      }
    ]
  },
  {
    "key": "a|dossier-2.a.q3|late",
    "variants": [
      {
        "id": "a|dossier-2.a.q3|late#1",
        "text": "아이를 지켜야 한다는 생각보다 제 과거가 학교에 알려진 순간, 엄마로서의 체면이 먼저 무너졌습니다.",
        "behaviorHint": "붕괴의 순간을 구체화한다."
      },
      {
        "id": "a|dossier-2.a.q3|late#2",
        "text": "그 순간 저는 아이보다 제 상담 기록이 먼저 판단받는다고 느꼈습니다.",
        "behaviorHint": "판단의 대상이 바뀐 충격을 말한다."
      },
      {
        "id": "a|dossier-2.a.q3|late#3",
        "text": "가장 크게 무너진 건 아이 문제가 아니라 제 이름이 기록으로 읽히는 방식이었습니다.",
        "behaviorHint": "핵심 상처를 단정한다."
      }
    ]
  },
  {
    "key": "b|dossier-2.b.q1|early",
    "variants": [
      {
        "id": "b|dossier-2.b.q1|early#1",
        "text": "본계정으로 보내면 너무 바로 드러날까 봐 보조 경로를 뒀습니다.",
        "behaviorHint": "숨김의 이유를 조심스럽게 밝힌다."
      },
      {
        "id": "b|dossier-2.b.q1|early#2",
        "text": "처음부터 눈에 띄지 않게 하려는 마음이 있었다고 인정합니다.",
        "behaviorHint": "의도를 낮춰서 말한다."
      },
      {
        "id": "b|dossier-2.b.q1|early#3",
        "text": "아내 이름이 적힌 본계정으로 남기기 싫어서, 숨길 수 있는 경로를 따로 만든 겁니다.",
        "behaviorHint": "경로 분리를 설명한다."
      }
    ]
  },
  {
    "key": "b|dossier-2.b.q1|mid",
    "variants": [
      {
        "id": "b|dossier-2.b.q1|mid#1",
        "text": "본계정으로 보내면 아내 쪽이 바로 드러날까 봐, 제가 먼저 피할 길을 만들었습니다.",
        "behaviorHint": "회피 목적을 분명히 한다."
      },
      {
        "id": "b|dossier-2.b.q1|mid#2",
        "text": "도윤 씨 본계정이 남는 걸 원치 않았고, 그래서 보조 경로를 썼습니다.",
        "behaviorHint": "자기보호를 솔직하게 말한다."
      },
      {
        "id": "b|dossier-2.b.q1|mid#3",
        "text": "아내 이름이 바로 연결될까 봐 숨길 수 있는 경로를 따로 뒀습니다.",
        "behaviorHint": "연결을 피한 이유를 직접 말한다."
      }
    ]
  },
  {
    "key": "b|dossier-2.b.q1|late",
    "variants": [
      {
        "id": "b|dossier-2.b.q1|late#1",
        "text": "아내 이름이 적힌 본계정으로 남기기 싫어서, 보조 계정과 우회 경로를 따로 만든 겁니다.",
        "behaviorHint": "숨김의 구조를 명확히 말한다."
      },
      {
        "id": "b|dossier-2.b.q1|late#2",
        "text": "본계정은 너무 바로 드러나니까, 저는 들키지 않을 경로를 먼저 골랐습니다.",
        "behaviorHint": "의도된 우회였음을 인정한다."
      },
      {
        "id": "b|dossier-2.b.q1|late#3",
        "text": "숨기려는 마음이 없었다고는 못 합니다. 그래서 본계정이 아니라 보조 경로를 쓴 겁니다.",
        "behaviorHint": "숨김 의도를 직접 인정한다."
      }
    ]
  },
  {
    "key": "b|dossier-2.b.q2|early",
    "variants": [
      {
        "id": "b|dossier-2.b.q2|early#1",
        "text": "아이를 지키려면 학교가 먼저 알아야 한다는 말을 붙였습니다.",
        "behaviorHint": "명분을 짧게 드러낸다."
      },
      {
        "id": "b|dossier-2.b.q2|early#2",
        "text": "보호가 먼저라는 생각으로 스스로를 설득했습니다.",
        "behaviorHint": "자기합리화를 조심스럽게 말한다."
      },
      {
        "id": "b|dossier-2.b.q2|early#3",
        "text": "선제 대응이라는 말을 붙여서 제가 한 일을 정당화했습니다.",
        "behaviorHint": "행위의 포장을 인정한다."
      }
    ]
  },
  {
    "key": "b|dossier-2.b.q2|mid",
    "variants": [
      {
        "id": "b|dossier-2.b.q2|mid#1",
        "text": "보호와 선제 대응이라는 명분으로 제 행동을 설명했습니다.",
        "behaviorHint": "명분의 이름을 정확히 말한다."
      },
      {
        "id": "b|dossier-2.b.q2|mid#2",
        "text": "학교가 미리 알아야 아이가 덜 흔들린다고 주장했습니다.",
        "behaviorHint": "학교를 끌어들인 이유를 말한다."
      },
      {
        "id": "b|dossier-2.b.q2|mid#3",
        "text": "상담 기록을 공개 정보처럼 다뤄도 된다고 스스로에게 말했다는 뜻입니다.",
        "behaviorHint": "정당화의 실체를 드러낸다."
      }
    ]
  },
  {
    "key": "b|dossier-2.b.q2|late",
    "variants": [
      {
        "id": "b|dossier-2.b.q2|late#1",
        "text": "상담 기록을 학교가 참고할 자료처럼 포장했습니다.",
        "behaviorHint": "포장 사실을 직접 인정한다."
      },
      {
        "id": "b|dossier-2.b.q2|late#2",
        "text": "제가 붙인 명분은 보호였지만, 실제로는 유출을 정리해 보이게 하는 말이었습니다.",
        "behaviorHint": "명분과 실체를 분리한다."
      },
      {
        "id": "b|dossier-2.b.q2|late#3",
        "text": "아이를 지킨다는 말을 앞세워 기록 전달의 무게를 줄이려 했습니다.",
        "behaviorHint": "행동의 의미를 인정한다."
      }
    ]
  },
  {
    "key": "b|dossier-2.b.q3|early",
    "variants": [
      {
        "id": "b|dossier-2.b.q3|early#1",
        "text": "지금은 보호라고 보지 않습니다. 배우자 동의 없는 전달을 그렇게 부를 수는 없습니다.",
        "behaviorHint": "입장을 낮추되 선을 긋는다."
      },
      {
        "id": "b|dossier-2.b.q3|early#2",
        "text": "아니요, 이제는 보호라는 말만으로 설명할 수 없다고 봅니다.",
        "behaviorHint": "수위를 낮춰 인정한다."
      },
      {
        "id": "b|dossier-2.b.q3|early#3",
        "text": "그때는 그렇게 부르고 싶었지만, 지금은 아니라고 말해야 합니다.",
        "behaviorHint": "현재 입장의 변화를 말한다."
      }
    ]
  },
  {
    "key": "b|dossier-2.b.q3|mid",
    "variants": [
      {
        "id": "b|dossier-2.b.q3|mid#1",
        "text": "아니요, 이제는 보호보다 무기화에 가깝다고 봅니다.",
        "behaviorHint": "의미를 다시 정의한다."
      },
      {
        "id": "b|dossier-2.b.q3|mid#2",
        "text": "동의 없이 기록을 넘긴 건 보호가 아니라 경계를 넘은 일입니다.",
        "behaviorHint": "경계 침범을 인정한다."
      },
      {
        "id": "b|dossier-2.b.q3|mid#3",
        "text": "제가 보호라고 말한 건 제 행동을 덜 무겁게 보이게 하려는 말이었습니다.",
        "behaviorHint": "자기합리화였음을 밝힌다."
      }
    ]
  },
  {
    "key": "b|dossier-2.b.q3|late",
    "variants": [
      {
        "id": "b|dossier-2.b.q3|late#1",
        "text": "아니요, 제가 보호라고 불렀던 건 결과적으로 상담 기록을 학교 판단의 무기로 쓴 일입니다.",
        "behaviorHint": "행위의 성격을 정확히 말한다."
      },
      {
        "id": "b|dossier-2.b.q3|late#2",
        "text": "그건 보호가 아니라 기록을 상대를 압박하는 재료로 쓴 것이었습니다.",
        "behaviorHint": "무기화의 의미를 분명히 한다."
      },
      {
        "id": "b|dossier-2.b.q3|late#3",
        "text": "지금 돌아보면, 저는 보호라는 말을 빌려 경계를 넘었습니다.",
        "behaviorHint": "후회의 의미를 담는다."
      }
    ]
  },
  {
    "key": "a|dossier-3.a.q1|early",
    "variants": [
      {
        "id": "a|dossier-3.a.q1|early#1",
        "text": "네, 자료 시점이 익명 글보다 어긋난 걸 보고 제 판단이 흔들렸습니다.",
