evice type --- */\n.ev-device-shell{\n  width:280px;margin:0 auto;\n  background:#08080e;border:2px solid rgba(255,255,255,.08);\n  border-radius:28px;padding:0;overflow:hidden;\n  box-shadow:0 8px 40px rgba(0,0,0,.5);\n}\n.ev-device-notch{\n  width:80px;height:6px;background:rgba(255,255,255,.08);\n  border-radius:0 0 4px 4px;margin:0 auto;\n}\n.ev-device-top{\n  display:flex;align-items:center;gap:8px;padding:10px 16px 8px;\n  font-size:13px;font-weight:600;color:var(--t2);border-bottom:1px solid rgba(255,255,255,.04);\n}\n.ev-device-top svg{width:14px;height:14px;color:var(--t3)}\n.ev-device-content{padding:8px 0 16px;max-height:380px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--p5) transparent}\n.ev-device-content::-webkit-scrollbar{width:3px}.ev-device-content::-webkit-scrollbar-thumb{background:var(--p5);border-radius:2px}\n.ev-device-section{margin:0 12px}\n.ev-device-section-header{\n  display:flex;align-items:center;gap:8px;padding:10px 8px;\n  font-size:13px;font-weight:700;color:var(--t3);cursor:pointer;\n  border-bottom:1px solid rgba(255,255,255,.03);transition:color .15s;\n  user-select:none;\n}\n.ev-device-section-header:hover{color:var(--t2)}\n.ev-device-section-header .arrow{font-size:10px;transition:transform .2s}\n.ev-device-section-header.collapsed .arrow{transform:rotate(-90deg)}\n.ev-device-section-body{overflow:hidden;transition:max-height .25s ease,opacity .25s;max-height:300px;opacity:1}\n.ev-device-section-body.collapsed{max-height:0;opacity:0}\n.ev-device-item{\n  padding:7px 12px;font-size:13px;color:var(--t2);line-height:1.5;\n  border-left:3px solid transparent;transition:all .15s;\n}\n.ev-device-item.suspicious{border-left-color:var(--gold);background:rgba(212,162,78,.04);color:var(--gold-l);font-weight:500}\n.ev-device-home{\n  width:40px;height:5px;background:rgba(255,255,255,.1);\n  border-radius:3px;margin:10px auto 12px;\n}\n\n/* --- SNS type --- */\n.ev-sns-post{\n  background:var(--p3);border:1px solid rgba(255,255,255,.06);\n  border-radius:14px;padding:18px 20px;margin-bottom:16px;\n}\n.ev-sns-profile{display:flex;align-items:center;gap:10px;margin-bottom:4px}\n.ev-sns-avatar{\n  width:36px;height:36px;border-radius:50%;\n  background:var(--blue-bg);border:1.5px solid var(--blue-bdr);\n  display:flex;align-items:center;justify-content:center;color:var(--blue);\n}\n.ev-sns-avatar svg{width:18px;height:18px}\n.ev-sns-username{font-size:14px;font-weight:700;color:var(--t1)}\n.ev-sns-handle{font-size:13px;color:var(--t3);font-weight:400}\n.ev-sns-date{font-size:12px;color:var(--t3);margin-left:auto}\n.ev-sns-scope{font-size:12px;color:var(--t3);margin-bottom:12px;padding-left:46px}\n.ev-sns-text{\n  font-size:16px;color:var(--t1);line-height:1.8;padding:12px 0;\n  border-top:1px solid rgba(255,255,255,.04);border-bottom:1px solid rgba(255,255,255,.04);\n}\n.ev-sns-text .hashtag{color:var(--blue);font-weight:500}\n.ev-sns-engage{display:flex;gap:24px;padding:10px 0 0;font-size:14px;color:var(--t3)}\n.ev-sns-engage span{display:flex;align-items:center;gap:6px}\n.ev-sns-comments{margin-bottom:16px}\n.ev-sns-comment-header{font-size:14px;font-weight:700;color:var(--t2);margin-bottom:10px;display:flex;align-items:center;gap:6px}\n.ev-sns-comment{\n  display:flex;gap:10px;padding:8px 0;font-size:14px;color:var(--t2);line-height:1.5;\n  border-bottom:1px solid rgba(255,255,255,.03);\n}\n.ev-sns-comment:last-child{border-bottom:none}\n.ev-sns-comment-name{font-weight:700;color:var(--t1);white-space:nowrap;min-width:48px}\n.ev-sns-warnings{display:flex;flex-direction:column;gap:8px}\n.ev-sns-warning{\n  display:flex;align-items:flex-start;gap:8px;padding:10px 14px;\n  border-radius:8px;background:rgba(224,160,60,.06);\n  border:1px solid rgba(224,160,60,.15);font-size:13px;color:#e0a03c;line-height:1.5;\n}\n.ev-sns-warning svg{width:16px;height:16px;flex-shrink:0;margin-top:1px}\n\n/* --- PC Home: DEV TEST --- */\n.pc-lobby__dev-test{\n  border:1px dashed rgba(224,96,96,.32);\n  border-radius:24px;\n  background:linear-gradient(180deg,rgba(88,24,24,.16),rgba(17,17,25,.82));\n  padding:18px 20px 20px;\n  display:flex;\n  flex-direction:column;\n  gap:16px;\n}\n.pc-lobby__dev-test-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}\n.pc-lobby__dev-test-copy{display:flex;flex-direction:column;gap:8px}\n.pc-lobby__dev-test-badge{\n  display:inline-flex;align-items:center;justify-content:center;align-self:flex-start;\n  min-height:24px;padding:0 10px;border-radius:999px;\n  background:rgba(224,96,96,.16);border:1px solid rgba(224,96,96,.28);\n  color:#ffb7b7;font-size:11px;font-weight:800;letter-spacing:.12em;\n}\n.pc-lobby__dev-test-copy strong{font-size:20px;letter-spacing:-.03em;color:#fbf7ef}\n.pc-lobby__dev-test-copy p{margin:0;color:#a6a3ae;font-size:13px;line-height:1.7}\n.pc-lobby__dev-test-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}\n.pc-lobby__dev-test-card{\n  min-height:148px;padding:16px;border-radius:18px;text-align:left;\n  border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);\n  display:flex;flex-direction:column;gap:10px;transition:all .16s ease;\n}\n.pc-lobby__dev-test-card:hover{\n  transform:translateY(-2px);\n  border-color:rgba(224,96,96,.24);\n  background:rgba(255,255,255,.06);\n}\n.pc-lobby__dev-test-card:disabled{\n  cursor:not-allowed;\n  opacity:.45;\n  transform:none;\n}\n.pc-lobby__dev-test-top{display:flex;align-items:center;justify-content:space-between;gap:10px}\n.pc-lobby__dev-test-tag{\n  display:inline-flex;align-items:center;min-height:24px;padding:0 9px;border-radius:999px;\n  background:rgba(212,162,78,.12);border:1px solid rgba(212,162,78,.22);\n  color:#f0d190;font-size:11px;font-weight:700;\n}\n.pc-lobby__dev-test-top small{color:#8d8b97;font-size:11px;font-weight:700}\n.pc-lobby__dev-test-card strong{color:#f6f1e7;font-size:17px;line-height:1.35;letter-spacing:-.03em}\n.pc-lobby__dev-test-card p{margin:0;color:#9694a0;font-size:12px;line-height:1.6}\n.pc-lobby__dev-test-state{\n  margin-top:auto;display:inline-flex;align-items:center;align-self:flex-start;\n  min-height:26px;padding:0 10px;border-radius:999px;\n  background:rgba(224,96,96,.1);border:1px solid rgba(224,96,96,.2);\n  color:#ffb7b7;font-size:11px;font-weight:700;\n}\n</style>\n</head>\n<body>\n\n<!-- ═══ SVG Defs ═══ -->\n<svg style=\"position:absolute;width:0;height:0\">\n<defs>\n  <!-- Judge (crown + balance) -->\n  <symbol id=\"i-judge\" viewBox=\"0 0 24 24\">\n    <circle cx=\"12\" cy=\"4\" r=\"1.5\" fill=\"currentColor\" opacity=\".6\"/>\n    <path d=\"M12 6v2M12 8L5 12l2 7h10l2-7z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/>\n    <path d=\"M8 15h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" opacity=\".4\"/>\n  </symbol>\n  <!-- Gavel (kept for logo) -->\n  <symbol id=\"i-gavel\" viewBox=\"0 0 24 24\"><path d=\"M17.3 3.3l3.4 3.4-2.1 2.1-3.4-3.4zM5 17.6L13.6 9l1.4 1.4L6.4 19H3v-3.4l2-2zM14.5 4.5L19.5 9.5l-1.4 1.4-5-5zM2 22h20v-2H2z\"/></symbol>\n  <!-- Scale -->\n  <symbol id=\"i-scale\" viewBox=\"0 0 24 24\"><path d=\"M12 2L1 7l3 9h4l3-9h2l3 9h4l3-9zM5.3 14L4 10.2 6.7 14zM18.7 14l-2.7 0L17.3 10.2zM11 18h2v4h-2z\"/><circle cx=\"12\" cy=\"7\" r=\"1.5\"/></symbol>\n  <!-- Lightning -->\n  <symbol id=\"i-bolt\" viewBox=\"0 0 24 24\"><path d=\"M13 2L4 14h6l-1 8 9-12h-6z\"/></symbol>\n  <!-- Magnifier -->\n  <symbol id=\"i-search\" viewBox=\"0 0 24 24\"><circle cx=\"10\" cy=\"10\" r=\"7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><line x1=\"15.5\" y1=\"15.5\" x2=\"21\" y2=\"21\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></symbol>\n  <!-- Sword (fact pursuit) -->\n  <symbol id=\"i-sword\" viewBox=\"0 0 24 24\"><path d=\"M19 2l3 3-10 10-3-3zM6 15l-4 4 3 3 4-4M9.5 14.5l-3-3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <!-- Eye (motive) -->\n  <symbol id=\"i-eye\" viewBox=\"0 0 24 24\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/><circle cx=\"12\" cy=\"12\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/></symbol>\n  <!-- Heart (empathy) -->\n  <symbol id=\"i-heart\" viewBox=\"0 0 24 24\"><path d=\"M12 21C12 21 3 14 3 8.5 3 5.4 5.4 3 8.5 3c1.7 0 3.3.8 3.5 2 .2-1.2 1.8-2 3.5-2C18.6 3 21 5.4 21 8.5 21 14 12 21 12 21z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/></symbol>\n  <!-- Brain (emotion analysis) -->\n  <symbol id=\"i-brain\" viewBox=\"0 0 24 24\"><path d=\"M12 2C9 2 7 4 7 6c-2 0-4 2-4 4s1 4 3 5v5h4v-2h4v2h4v-5c2-1 3-3 3-5s-2-4-4-4c0-2-2-4-5-4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M12 2v20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" opacity=\".3\"/></symbol>\n  <!-- Shield (appraise) -->\n  <symbol id=\"i-shield\" viewBox=\"0 0 24 24\"><path d=\"M12 2L4 6v5c0 5.5 3.8 10 8 11 4.2-1 8-5.5 8-11V6z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M9 12l2 2 4-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <!-- Document -->\n  <symbol id=\"i-doc\" viewBox=\"0 0 24 24\"><path d=\"M6 2h8l6 6v14H6z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M14 2v6h6M9 13h6M9 17h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></symbol>\n  <!-- Chat bubble -->\n  <symbol id=\"i-chat\" viewBox=\"0 0 24 24\"><path d=\"M4 4h16v12H8l-4 4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/></symbol>\n  <!-- Ledger -->\n  <symbol id=\"i-ledger\" viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"2\" width=\"16\" height=\"20\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M8 7h8M8 11h8M8 15h5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\"/><path d=\"M4 6h2M4 10h2M4 14h2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\"/></symbol>\n  <!-- Camera -->\n  <symbol id=\"i-cam\" viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"6\" width=\"20\" height=\"14\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><circle cx=\"12\" cy=\"13\" r=\"4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M8 6l1-3h6l1 3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/></symbol>\n  <!-- Person -->\n  <symbol id=\"i-person\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"7\" r=\"4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M4 21v-2c0-3.3 2.7-6 6-6h4c3.3 0 6 2.7 6 6v2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/></symbol>\n  <!-- Phone -->\n  <symbol id=\"i-phone\" viewBox=\"0 0 24 24\"><rect x=\"7\" y=\"2\" width=\"10\" height=\"20\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><line x1=\"10\" y1=\"18\" x2=\"14\" y2=\"18\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></symbol>\n  <!-- Pin -->\n  <symbol id=\"i-pin\" viewBox=\"0 0 24 24\"><path d=\"M16 4L8 12l-1 5 5-1 8-8zM14 6l4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <!-- SNS / Share -->\n  <symbol id=\"i-sns\" viewBox=\"0 0 24 24\"><circle cx=\"18\" cy=\"5\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><circle cx=\"6\" cy=\"12\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><circle cx=\"18\" cy=\"19\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M8.6 13.5l6.8 4M8.6 10.5l6.8-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/></symbol>\n  <!-- Smartphone (device) -->\n  <symbol id=\"i-smartphone\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"1\" width=\"12\" height=\"22\" rx=\"2.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><line x1=\"10\" y1=\"19\" x2=\"14\" y2=\"19\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/><path d=\"M10 4h4\" stroke=\"currentColor\" stroke-width=\"1\" stroke-linecap=\"round\" opacity=\".4\"/></symbol>\n  <!-- Send -->\n  <symbol id=\"i-send\" viewBox=\"0 0 24 24\"><path d=\"M22 2L11 13M22 2l-7 20-4-9-9-4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/></symbol>\n  <!-- Droplet (leak) -->\n  <symbol id=\"i-drop\" viewBox=\"0 0 24 24\"><path d=\"M12 2C12 2 5 10 5 15a7 7 0 0014 0c0-5-7-13-7-13z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/></symbol>\n  <!-- Conflict (contra) -->\n  <symbol id=\"i-conflict\" viewBox=\"0 0 24 24\"><path d=\"M6 18L18 6M6 6l12 12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></symbol>\n  <!-- Handshake (trust) -->\n  <symbol id=\"i-hand\" viewBox=\"0 0 24 24\"><path d=\"M2 11l4-4h4l6 6-5 5-4-4M22 11l-4-4h-3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <!-- Lightbulb (sys) -->\n  <symbol id=\"i-bulb\" viewBox=\"0 0 24 24\"><path d=\"M9 21h6M12 2a7 7 0 00-4 12.7V17h8v-2.3A7 7 0 0012 2z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/></symbol>\n  <!-- Phase clock -->\n  <symbol id=\"i-clock\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M12 7v5l3 3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></symbol>\n  <!-- Crown (rank) -->\n  <symbol id=\"i-crown\" viewBox=\"0 0 24 24\"><path d=\"M4 18h16l-2-10-4 4-2-6-2 6-4-4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/></symbol>\n  <!-- ═══ Character Faces ═══ -->\n  <!--\n    ♂ 최민준: 7:3 가르마 머리 (filled), 귀 보임\n    ♀ 박서연: 단발 보브컷 (filled, 턱선까지, 귀