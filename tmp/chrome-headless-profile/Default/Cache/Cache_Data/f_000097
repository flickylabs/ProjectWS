export default "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>솔로몬 법정 — PC(Steam) v7</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700;900&display=swap\" rel=\"stylesheet\">\n<style>\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\n:root{\n  --gold:#d4a24e;--gold-l:#e8c172;--gold-d:#8b6914;--gold-bg:rgba(212,162,78,.06);--gold-bdr:rgba(212,162,78,.18);\n  --bg:#07070c;--p1:#0c0c14;--p2:#111119;--p3:#18181f;--p4:#1f1f28;--p5:#282832;\n  --t1:#dcdce0;--t2:#8b8b9a;--t3:#4e4e5c;\n  --blue:#5b8def;--blue-bg:rgba(91,141,239,.08);--blue-bdr:rgba(91,141,239,.2);\n  --red:#e06060;--red-bg:rgba(224,96,96,.08);--red-bdr:rgba(224,96,96,.2);\n  --green:#5cc97a;--purple:#9b7be8;\n  --font:'Noto Sans KR',system-ui,sans-serif;--r:10px;--r-sm:6px;\n}\nhtml,body{height:100%;background:var(--bg);color:var(--t1);font-family:var(--font);overflow:hidden;user-select:none;font-size:15px;-webkit-font-smoothing:antialiased}\nsvg{display:inline-block;vertical-align:middle;fill:currentColor}\n\n.app{display:grid;grid-template-columns:400px 1fr 380px;grid-template-rows:52px 1fr;height:100vh}\n\n/* ── Header ── */\nheader{grid-column:1/-1;background:var(--p1);border-bottom:1px solid rgba(255,255,255,.04);display:flex;align-items:center;padding:0 24px;gap:16px}\n.logo-group{display:flex;align-items:center;gap:10px}\n.logo-icon{color:var(--gold);width:28px;height:28px}\n.logo-text{font-size:20px;font-weight:700;color:var(--gold);letter-spacing:-.02em}\n.logo-case{font-size:15px;color:var(--t3);font-weight:400;margin-left:4px}\n.phase-pill{display:flex;align-items:center;gap:6px;background:rgba(212,162,78,.08);border:1px solid var(--gold-bdr);color:var(--gold-l);padding:4px 14px;border-radius:20px;font-size:14px;font-weight:500}\n.phase-pill svg{width:14px;height:14px;opacity:.7}\nheader nav{margin-left:auto;display:flex;align-items:center;gap:20px;font-size:15px;color:var(--t2)}\n.res{display:flex;align-items:center;gap:5px}.res svg{width:16px;height:16px;opacity:.6}.res b{color:var(--t1);font-weight:600}\n.nav-sep{width:1px;height:16px;background:var(--p5)}\n\n/* ── Panels ── */\n.panel{overflow-y:auto;display:flex;flex-direction:column;scrollbar-width:thin;scrollbar-color:var(--p5) transparent}\n.panel::-webkit-scrollbar{width:4px}.panel::-webkit-scrollbar-thumb{background:var(--p5);border-radius:2px}\n.panel-l{background:var(--p1);border-right:1px solid rgba(255,255,255,.03)}\n.panel-r{background:var(--p1);border-left:1px solid rgba(255,255,255,.03)}\n.sec{padding:22px 24px 18px}.sec+.sec{border-top:1px solid rgba(255,255,255,.03)}\n.sec-h{font-size:12px;font-weight:600;color:var(--t3);text-transform:uppercase;letter-spacing:.12em;margin-bottom:16px;display:flex;align-items:center;gap:8px}\n.sec-h svg{width:14px;height:14px;opacity:.5}\n.sec-h .cnt{margin-left:4px;font-size:11px;background:var(--p4);color:var(--t2);padding:1px 8px;border-radius:10px;letter-spacing:0;text-transform:none;font-weight:500}\n.sec-h .sub{margin-left:auto;font-size:11px;color:var(--t3);text-transform:none;letter-spacing:0;font-weight:400}\n\n/* Disputes */\n.dispute{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:var(--r-sm);margin-bottom:4px;cursor:pointer;transition:all .15s;border:1px solid transparent}\n.dispute:hover{background:rgba(255,255,255,.02);border-color:rgba(255,255,255,.04)}\n.dispute.active{background:var(--gold-bg);border-color:var(--gold-bdr)}\n.d-num{font-size:13px;color:var(--t3);font-weight:600;font-variant-numeric:tabular-nums}\n.d-name{flex:1;font-size:17px;color:var(--t2)}.dispute.active .d-name{color:var(--t1)}\n.d-pill{font-size:12px;font-weight:700;padding:3px 8px;border-radius:4px}\n.dp-0{background:rgba(224,96,96,.1);color:#e88}.dp-1{background:rgba(224,96,96,.1);color:#e88}\n.dp-2{background:rgba(212,162,78,.1);color:var(--gold-l)}.dp-3{background:rgba(212,162,78,.15);color:var(--gold-l)}\n\n/* Evidence */\n.ev-card{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:var(--r-sm);margin-bottom:4px;cursor:grab;transition:all .15s;border:1px solid transparent}\n.ev-card:hover{background:rgba(255,255,255,.02);border-color:rgba(255,255,255,.04)}\n.ev-card.rec{background:var(--gold-bg);border-color:var(--gold-bdr)}\n.ev-ico{width:36px;height:36px;border-radius:8px;background:var(--p3);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--t2)}\n.ev-card.rec .ev-ico{background:rgba(212,162,78,.1);color:var(--gold)}\n.ev-ico svg{width:18px;height:18px}\n.ev-nm{flex:1;font-size:17px;color:var(--t2)}.ev-card.rec .ev-nm{color:var(--t1)}\n.ev-badge{font-size:11px;padding:2px 8px;border-radius:4px;font-weight:600}\n.badge-rec{background:rgba(212,162,78,.15);color:var(--gold-l)}.badge-new{background:rgba(91,141,239,.12);color:var(--blue)}\n\n/* Meters */\n.meter-group{display:flex;flex-direction:column;gap:14px}\n.meter{display:flex;align-items:center;gap:12px}\n.meter svg{width:16px;height:16px;color:var(--t3);flex-shrink:0}\n.meter-track{flex:1;height:8px;background:var(--p4);border-radius:4px;overflow:hidden}\n.meter-fill{height:100%;border-radius:4px;transition:width 1s cubic-bezier(.4,0,.2,1)}\n.mf-leak{width:45%;background:linear-gradient(90deg,var(--gold-d),var(--gold))}\n.mf-contra{width:66%;background:linear-gradient(90deg,#b04040,var(--red))}\n.mf-trust{width:30%;background:linear-gradient(90deg,#3a6cc2,var(--blue))}\n.meter-val{font-size:14px;color:var(--t3);min-width:36px;text-align:right;font-variant-numeric:tabular-nums;font-weight:500}\n\n/* Judge */\n.axes{display:flex;flex-direction:column;gap:10px}\n.axis{display:flex;align-items:center;gap:10px}\n.ax-nm{font-size:14px;color:var(--t3);width:40px;font-weight:500}\n.ax-bar{flex:1;height:6px;background:var(--p4);border-radius:3px;overflow:hidden}\n.ax-fill{height:100%;border-radius:3px}\n.judge-rank{margin-top:14px;font-size:14px;color:var(--t3);display:flex;align-items:center;gap:8px}\n.judge-rank svg{width:16px;height:16px;color:var(--gold)}\n.judge-rank b{color:var(--gold);font-weight:600}\n\n/* ═══ RIGHT ═══ */\n.target{display:flex;gap:18px;align-items:center}\n.tgt-face{width:72px;height:90px;border-radius:var(--r);display:flex;align-items:center;justify-content:center;flex-shrink:0;border:2px solid var(--red-bdr);background:var(--red-bg);color:var(--red);overflow:hidden}\n.tgt-face svg{width:64px;height:64px}\n.tgt-name{font-size:22px;font-weight:700;color:var(--red);margin-bottom:2px}\n.tgt-meta{font-size:15px;color:var(--t2);margin-bottom:8px}\n.tgt-tags{display:flex;gap:6px}\n.tag{font-size:13px;padding:3px 10px;border-radius:5px;font-weight:500}\n.tag-arch{background:rgba(155,123,232,.1);color:#b9a0f0;border:1px solid rgba(155,123,232,.15)}\n.tag-tell{background:rgba(91,141,239,.08);color:#8ab4f0;border:1px solid rgba(91,141,239,.12)}\n\n.lie-bar{display:flex;gap:5px;margin:16px 0}\n.lie-s{flex:1;height:32px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;transition:all .3s}\n.ls-done{background:rgba(224,96,96,.25);color:rgba(255,255,255,.7)}\n.ls-now{background:var(--gold);color:var(--bg);box-shadow:0 0 16px rgba(212,162,78,.3);transform:scale(1.06)}\n.ls-lock{background:var(--p3);color:var(--t3)}\n\n.emo{display:flex;align-items:center;gap:12px;font-size:15px}\n.emo svg{width:16px;height:16px;color:var(--t3);flex-shrink:0}\n.emo-track{flex:1;height:10px;background:var(--p4);border-radius:5px;overflow:hidden;position:relative}\n.emo-fill{height:100%;border-radius:5px;background:linear-gradient(90deg,var(--gold),var(--red))}\n.emo-tick{position:absolute;top:0;bottom:0;width:1px;background:rgba(255,255,255,.08)}\n.emo-val{font-size:14px;font-weight:600;color:#e88}\n\n/* Notes */\n.note-list{display:flex;flex-direction:column;gap:6px}\n.note{display:flex;gap:12px;padding:12px 14px;border-radius:var(--r-sm);border-left:3px solid var(--p4);background:rgba(255,255,255,.01);cursor:pointer;transition:all .15s}\n.note:hover{background:rgba(255,255,255,.025)}\n.note.pin{border-left-color:var(--gold);background:var(--gold-bg)}\n.note.ctr{border-left-color:var(--red);background:var(--red-bg)}\n.n-t{font-size:13px;color:var(--t3);min-width:28px;font-weight:600;padding-top:2px;font-variant-numeric:tabular-nums}\n.n-body{flex:1;font-size:16px;color:var(--t2);line-height:1.6}.note.pin .n-body{color:var(--t1)}\n.n-body em{font-style:normal;font-weight:600}.n-body em.gold{color:var(--gold-l)}.n-body em.red{color:var(--red)}\n.n-pin{opacity:.2;cursor:pointer;transition:all .15s;padding-top:2px;color:var(--t2)}\n.n-pin:hover{opacity:.8}.note.pin .n-pin{opacity:1;color:var(--gold)}\n.n-pin svg{width:16px;height:16px}\n\n/* Timeline */\n.timeline{display:flex;flex-direction:column;position:relative;padding-left:14px}\n.timeline::before{content:'';position:absolute;left:6px;top:8px;bottom:8px;width:2px;background:var(--p4);border-radius:1px}\n.tl{display:flex;gap:16px;padding:10px 0;position:relative}\n.tl-dot{width:14px;height:14px;border-radius:50%;flex-shrink:0;margin-top:4px;z-index:1;margin-left:-8px;border:2px solid var(--p4);background:var(--p1)}\n.tl-dot.done{border-color:var(--green);background:var(--green)}\n.tl-dot.now{border-color:var(--gold);background:var(--gold);box-shadow:0 0 8px rgba(212,162,78,.4)}\n.tl-dot.locked{border-style:dashed;border-color:var(--t3)}\n.tl-date{font-size:13px;color:var(--t3);margin-bottom:1px;font-weight:500}\n.tl-text{font-size:16px;color:var(--t2);line-height:1.5}\n.tl.done .tl-text{color:var(--t1)}\n.tl.now .tl-text{color:var(--gold-l);font-weight:500}\n\n/* ═══ CENTER ═══ */\n.center{display:flex;flex-direction:column;position:relative;overflow:hidden;background:var(--bg)}\n.amb{position:absolute;inset:0;pointer-events:none}\n.amb-1{background:radial-gradient(ellipse at 20% 60%,rgba(91,141,239,.02),transparent 50%)}\n.amb-2{background:radial-gradient(ellipse at 80% 60%,rgba(224,96,96,.02),transparent 50%)}\n.amb-3{background:radial-gradient(ellipse at 50% 0%,rgba(212,162,78,.015),transparent 50%)}\n.vig{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at center,transparent 50%,rgba(0,0,0,.35))}\n/* Watermark */\n.watermark{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none;opacity:.015;color:var(--gold)}\n.watermark svg{width:300px;height:300px}\n\n/* Chat */\n.chat-area{flex:1;overflow-y:auto;padding:28px 40px 16px;display:flex;flex-direction:column;gap:12px;z-index:1;scrollbar-width:thin;scrollbar-color:var(--p5) transparent}\n.chat-area::-webkit-scrollbar{width:4px}.chat-area::-webkit-scrollbar-thumb{background:var(--p5);border-radius:2px}\n\n.msg{display:flex;align-items:flex-start;gap:14px;max-width:78%;animation:msgIn .3s ease}\n@keyframes msgIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}\n.msg-av{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:4px}\n.msg-av svg{width:24px;height:24px}\n.msg-who{font-size:13px;font-weight:600;margin-bottom:4px;padding-left:2px}\n.msg-text{padding:14px 20px;border-radius:18px;font-size:18px;line-height:1.75}\n\n.msg.a{align-self:flex-start}.msg.a .msg-av{background:var(--blue-bg);border:1px solid var(--blue-bdr);color:var(--blue)}\n.msg.a .msg-who{color:var(--blue)}.msg.a .msg-text{background:var(--blue-bg);border:1px solid var(--blue-bdr);border-top-left-radius:4px}\n\n.msg.b{align-self:flex-end;flex-direction:row-reverse}.msg.b .msg-bd{display:flex;flex-direction:column;align-items:flex-end}\n.msg.b .msg-who{color:var(--red);padding-right:2px;padding-left:0}.msg.b .msg-av{background:var(--red-bg);border:1px solid var(--red-bdr);color:var(--red)}\n.msg.b .msg-text{background:var(--red-bg);border:1px solid var(--red-bdr);border-top-right-radius:4px;text-align:left}\n\n.msg.j{align-self:center;max-width:68%}.msg.j .msg-av{background:var(--gold-bg);border:1px solid var(--gold-bdr);color:var(--gold)}\n.msg.j .msg-who{color:var(--gold)}.msg.j .msg-text{background:var(--gold-bg);border:1px solid var(--gold-bdr);border-radius:14px;font-weight:500}\n\n.sys-msg{align-self:center;font-size:15px;color:var(--gold);padding:8px 24px;border-radius:24px;background:rgba(212,162,78,.05);border:1px solid rgba(212,162,78,.1);animation:msgIn .3s ease;display:flex;align-items:center;gap:8px}\n.sys-msg svg{width:16px;height:16px;flex-shrink:0}\n\n/* ═══ Bottom Dock ═══ */\n.bottom{\n  z-index:2;padding:0 28px 14px;\n  display:flex;flex-direction:column;gap:8px;\n  background:linear-gradient(180deg,transparent 0%,var(--p1) 30%);\n}\n\n/* Palette */\n.palette{display:none;padding:10px 18px;background:var(--p2);border-radius:12px;border:1px solid rgba(255,255,255,.04)}\n.palette.open{display:flex;gap:8px;align-items:center;flex-wrap:wrap}\n.pal-h{font-size:13px;color:var(--t3);margin-right:12px;font-weight:600}\n.pal-i{display:flex;align-items:center;gap:8px;padding:8px 14px;border-radius:8px;background:var(--p3);border:1px solid rgba(255,255,255,.05);cursor:grab;font-size:15px;color:var(--t2);transition:all .2s}\n.pal-i:hover{background:var(--p4);color:var(--t1);border-color:rgba(255,255,255,.1)}.pal-i.used{opacity:.2;cursor:default}\n.pal-i svg{width:20px;height:20px}\n\n/* Input — hidden by default, shown when free-question slot is active */\n.input-row{display:none;gap:10px;animation:slideUp .2s ease}\n.input-row.open{display:flex}\n@keyframes slideUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}\n.input-field{flex:1;padding:12px 20px;border-radius:12px;background:var(--p2);border:1px solid rgba(255,255,255,.05);color:var(--t1);font-size:16px;font-family:var(--font);outline:none;transition:all .2s}\n.input-field:focus{border-color:var(--gold-bdr);box-shadow:0 0 16px rgba(212,162,78,.06)}.input-field::placeholder{color:var(--t3)}\n.input-send{padding:12px 24px;border-radius:12px;background:rgba(212,162,78,.08);border:1px solid var(--gold-bdr);color:var(--gold);font-weight:600;font-size:15px;cursor:pointer;font-family:var(--font);transition:all .2s;display:flex;align-items:center;gap:6px}\n.input-send:hover{background:rgba(212,162,78,.18);color:var(--gold-l);box-shadow:0 0 16px rgba(212,162,78,.1)}\n.input-send svg{width:16px;height:16px}\n\n/* ── Hotbar Row: char ← hotbar → char ── */\n.hbar{display:flex;align-items:flex-end;gap:0}\n\n/* Character card — aligned to .hotbar element */\n.char{\n  display:flex;align-items:center;gap:14px;\n  cursor:pointer;transition:all .25s;\n  padding:0 14px;border-radius:14px;\n  height:100px;min-width:180px;\n}\n.char:hover{background:rgba(255,255,255,.02)}\n.char.spk{background:rgba(212,162,78,.04)}\n.char-a{flex-direction:row}\n.char-b{flex-direction:row-reverse}\n\n.char-face{\n  width:64px;height:64px;border-radius:50%;\n  display:flex;align-items:center;justify-content:center;\n  transition:all .3s;flex-shrink:0;\n}\n.char.spk .char-face{box-shadow:0 0 20px rgba(212,162,78,.2)}\n.char-a .char-face{background:linear-gradient(135deg,rgba(91,141,239,.12),rgba(91,141,239,.04));border:2px solid var(--blue-bdr);color:var(--blue)}\n.char-b .char-face{background:linear-gradient(135deg,rgba(224,96,96,.12),rgba(224,96,96,.04));border:2px solid var(--red-bdr);color:var(--red)}\n.char.spk .char-face{border-color:var(--gold)}\n.char-face svg{width:52px;height:52px}\n\n/* Info block beside portrait */\n.char-info{display:flex;flex-direction:column;gap:3px}\n.char-a .char-info{align-items:flex-start}\n.char-b .char-info{align-items:flex-end}\n.char-nm{font-size:14px;font-weight:700;line-height:1}\n.char-a .char-nm{color:var(--blue)}.char-b .char-nm{color:var(--red)}\n.char-emo{font-size:11px;padding:2px 8px;border-radius:10px;font-weight:500;line-height:1.2}\n.ce-cf{background:var(--blue-bg);color:var(--blue)}.ce-sh{background:var(--red-bg);color:var(--red);animation:pls 2.5s ease-in-out infinite}\n@keyframes pls{0%,100%{opacity:1}50%{opacity:.5}}\n.char-hp{width:56px;height:4px;background:var(--p4);border-radius:2px;overflow:hidden}\n.char-hp-f{height:100%;border-radius:2px}\n.char-a .char-hp-f{background:var(--blue);width:72%}.char-b .char-hp-f{background:var(--red);width:38%}\n\n/* Hotbar center */\n.hb-center{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px}\n.hb-tip{font-size:12px;color:var(--t3);display:flex;align-items:center;gap:12px}\n.hb-tip kbd{background:var(--p3);border:1px solid var(--p5);border-radius:4px;padding:1px 6px;font-size:11px;font-family:var(--font)}\n/* Page tabs */\n.hb-tabs{display:flex;gap:4px}\n.hb-tab{\n  padding:2px 10px;border-radius:6px;font-size:11px;font-weight:600;\n  color:var(--t3);background:transparent;border:1px solid transparent;\n  cursor:pointer;transition:all .15s;font-family:var(--font);\n  display:flex;align-items:center;gap:4px;\n}\n.hb-tab:hover{color:var(--t2);background:var(--p3)}\n.hb-tab.active{color:var(--gold-l);background:rgba(212,162,78,.08);border-color:var(--gold-bdr)}\n.hb-tab kbd{font-size:10px;background:rgba(0,0,0,.3);border:1px solid var(--p5);border-radius:3px;padding:0 4px;font-family:var(--font)}\n.hotbar{display:flex;gap:8px;padding:6px 14px;background:var(--p2);border-radius:16px;border:1px solid rgba(255,255,255,.04)}\n.hb-page{animation:pageIn .15s ease}\n.hb-page:not(.active){display:none}\n@keyframes pageIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}\n\n/* Slots — 6 slots, larger */\n.slot{\n  width:100px;height:88px;border-radius:12px;\n  background:linear-gradient(180deg,var(--p3),var(--p4));\n  border:1.5px solid rgba(255,255,255,.05);\n  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;\n  cursor:pointer;transition:all .2s;position:relative;\n}\n.slot:hover{\n  background:linear-gradient(180deg,var(--p4),var(--p5));\n  border-color:rgba(255,255,255,.1);\n  transform:trans