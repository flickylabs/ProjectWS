vg class=\"verdict-card-icon\" viewBox=\"0 0 24 24\"><use href=\"#i-heart\"/></svg>\n          <div class=\"verdict-card-title\">화해 중심 해결</div>\n          <div class=\"verdict-card-summary\">양측이 합의점을 찾고 관계를 회복합니다</div>\n          <button class=\"verdict-card-btn\">선택</button>\n        </div>\n        <div class=\"verdict-card\" data-solution=\"principle\">\n          <svg class=\"verdict-card-icon\" viewBox=\"0 0 24 24\"><use href=\"#i-scale\"/></svg>\n          <div class=\"verdict-card-title\">원칙 기반 판결</div>\n          <div class=\"verdict-card-summary\">법적 기준에 따라 책임을 명확히 합니다</div>\n          <button class=\"verdict-card-btn\">선택</button>\n        </div>\n        <div class=\"verdict-card\" data-solution=\"strict\">\n          <svg class=\"verdict-card-icon\" viewBox=\"0 0 24 24\"><use href=\"#i-sword\"/></svg>\n          <div class=\"verdict-card-title\">강경 대응</div>\n          <div class=\"verdict-card-summary\">위반 행위에 대해 엄격한 처분을 내립니다</div>\n          <button class=\"verdict-card-btn\">선택</button>\n        </div>\n      </div>\n      <button class=\"verdict-back-btn\" id=\"verdict-back-btn\"><span style=\"font-size:14px\">&larr;</span> 이전</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"hints\"><span><kbd>1</kbd>-<kbd>6</kbd> 핫바</span><span><kbd>F1</kbd><kbd>F2</kbd><kbd>F3</kbd> 페이지</span><span><kbd>Tab</kbd> 팔레트</span><span><kbd>F</kbd> 포커스</span><span><kbd>O</kbd> 모순</span><span><kbd>N</kbd> 배너</span><span><kbd>M</kbd> 선택지</span><span><kbd>B</kbd> 돌발</span><span><kbd>V</kbd> 판결</span></div>\n\n<!-- ═══ Settings Drawer ═══ -->\n<div class=\"settings-backdrop\" id=\"set-backdrop\"></div>\n<div class=\"settings-drawer\" id=\"set-drawer\">\n  <div class=\"set-header\">\n    <span class=\"set-title\">설정</span>\n    <button class=\"set-close\" id=\"set-close\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\"><path d=\"M18 6L6 18M6 6l12 12\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></button>\n  </div>\n  <div class=\"set-body\">\n    <div class=\"set-row\">\n      <span class=\"set-label\">UI 크기</span>\n      <div class=\"set-ctrl\">\n        <input type=\"range\" class=\"set-range\" id=\"set-scale\" min=\"80\" max=\"150\" value=\"100\" step=\"5\">\n        <span class=\"set-val\" id=\"set-scale-val\">100%</span>\n      </div>\n    </div>\n    <div class=\"set-row\">\n      <span class=\"set-label\">텍스트 속도</span>\n      <div class=\"set-ctrl\">\n        <div class=\"set-toggles\" id=\"set-speed\">\n          <button class=\"set-tog\" data-speed=\"50\">느리게</button>\n          <button class=\"set-tog active\" data-speed=\"30\">보통</button>\n          <button class=\"set-tog\" data-speed=\"15\">빠르게</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"set-row\">\n      <span class=\"set-label\">BGM 볼륨</span>\n      <div class=\"set-ctrl\">\n        <input type=\"range\" class=\"set-range\" id=\"set-bgm\" min=\"0\" max=\"100\" value=\"70\">\n        <span class=\"set-val\" id=\"set-bgm-val\">70%</span>\n      </div>\n    </div>\n    <div class=\"set-row\">\n      <span class=\"set-label\">효과음 볼륨</span>\n      <div class=\"set-ctrl\">\n        <input type=\"range\" class=\"set-range\" id=\"set-sfx\" min=\"0\" max=\"100\" value=\"80\">\n        <span class=\"set-val\" id=\"set-sfx-val\">80%</span>\n      </div>\n    </div>\n    <div class=\"set-row\">\n      <span class=\"set-label\">전체화면</span>\n      <div class=\"set-ctrl\">\n        <button class=\"set-fs-btn\" id=\"set-fs\">전체화면</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\nconst $=s=>document.querySelector(s),$$=s=>document.querySelectorAll(s);\nconst sd={'sk-fact':{n:'사실 추궁',d:'모순 토큰 +1, 상태 전이 촉진\\n현재 S2에서 가장 효과적',c:''},'sk-motive':{n:'동기 탐색',d:'누설 미터 +15%\\nS3 이후 효과 증가',c:''},'sk-empathy':{n:'공감 접근',d:'신뢰 +10, 방어 완화\\n현재 교착 상태',c:''},'sk-free':{n:'자유 질문',d:'직접 질문을 작성',c:'⚡ 3'},'sk-emotion':{n:'감정 분석',d:'감정 상태 분석',c:'🔍 1'},'sk-appraise':{n:'증거 감별',d:'증거 진위 판별',c:'⚖ 20'},'ev-bank':{n:'계좌 이체 내역',d:'비밀 송금 3건의 상세 내역',c:'증거 제시'},'ev-chat':{n:'카카오톡 대화',d:'당사자 간 메시지 기록',c:'증거 제시'},'ev-book':{n:'가계부 사본',d:'불일치 항목이 포함된 가계부',c:'증거 제시'}};\n\n// ── Page Switching ──\nlet currentPage=1;\nfunction switchPage(page){\n  currentPage=page;\n  $$('.hb-page').forEach(p=>{\n    const on=p.dataset.page==page;\n    p.classList.toggle('active',on);\n    p.style.display=on?'flex':'none';\n  });\n  $$('.hb-tab').forEach(t=>t.classList.toggle('active',t.dataset.page==page));\n  $('.input-row').classList.remove('open');\n}\n$$('.hb-tab').forEach(t=>{t.addEventListener('click',()=>switchPage(parseInt(t.dataset.page)))});\n\n// ── Tooltip ──\nconst tt=$('#tt');\nfunction bindTooltip(s){\n  s.addEventListener('mouseenter',()=>{\n    const k=s.dataset.skill;if(!k||!sd[k])return;const d=sd[k];\n    tt.querySelector('.tt-h').innerHTML=d.n;tt.querySelector('.tt-d').textContent=d.d;tt.querySelector('.tt-c').innerHTML=d.c;\n    const r=s.getBoundingClientRect();tt.style.left=r.left+r.width/2-140+'px';tt.style.top=r.top-110+'px';tt.classList.add('vis');\n  });\n  s.addEventListener('mouseleave',()=>tt.classList.remove('vis'));\n}\n$$('.slot').forEach(bindTooltip);\n\n// ── Free Question ──\nfunction toggleFreeQ(slotEl){\n  const isFree=slotEl&&slotEl.dataset.skill==='sk-free';\n  const row=$('.input-row');\n  if(isFree){row.classList.toggle('open');if(row.classList.contains('open'))row.querySelector('input').focus()}\n  else{row.classList.remove('open')}\n}\n$$('.slot').forEach(s=>{s.addEventListener('click',()=>{if(!s.classList.contains('empty')&&!s.classList.contains('slot-locked'))toggleFreeQ(s)})});\n\n// ── Keyboard ──\ndocument.addEventListener('keydown',e=>{\n  if(e.key==='F1'){e.preventDefault();switchPage(1)}\n  if(e.key==='F2'){e.preventDefault();switchPage(2)}\n  if(e.key==='F3'){e.preventDefault();switchPage(3)}\n  const n=parseInt(e.key);\n  if(n>=1&&n<=6){\n    const pg=$(`.hb-page.active`);\n    const s=pg&&pg.querySelector(`.slot[data-slot=\"${n}\"]`);\n    if(s&&!s.classList.contains('empty')&&!s.classList.contains('slot-locked')){s.classList.add('act');setTimeout(()=>s.classList.remove('act'),300);toggleFreeQ(s)}\n  }\n  if(e.key==='Tab'){e.preventDefault();$('#pal').classList.toggle('open')}\n  if(e.key==='o'||e.key==='O'){$('#obj').classList.add('show');setTimeout(()=>$('#obj').classList.remove('show'),3000)}\n  if(e.key==='Escape'){$('#obj').classList.remove('show');$('#pal').classList.remove('open');$('.input-row').classList.remove('open')}\n});\n\n// ── Drag & Drop ──\nlet dd=null;\n$$('.pal-i').forEach(i=>{i.addEventListener('dragstart',()=>{dd={id:i.dataset.id,icon:i.dataset.icon,name:i.dataset.name};i.style.opacity='.4'});i.addEventListener('dragend',()=>{i.style.opacity=''})});\n$$('.ev-card').forEach(c=>{c.addEventListener('dragstart',()=>{dd={id:c.dataset.id,icon:c.dataset.icon,name:c.dataset.name};c.style.opacity='.4'});c.addEventListener('dragend',()=>{c.style.opacity=''})});\n$$('.slot').forEach(s=>{\n  s.addEventListener('dragover',e=>{if(s.classList.contains('slot-locked'))return;e.preventDefault();s.classList.add('dov')});\n  s.addEventListener('dragleave',()=>s.classList.remove('dov'));\n  s.addEventListener('drop',e=>{\n    e.preventDefault();s.classList.remove('dov');if(!dd||s.classList.contains('slot-locked'))return;\n    s.dataset.skill=dd.id;s.classList.remove('empty');\n    s.querySelector('.slot-ico').innerHTML=`<svg><use href=\"#${dd.icon}\"/></svg>`;\n    s.querySelector('.slot-ico').style.color='';\n    s.querySelector('.slot-nm').textContent=dd.name;\n    s.querySelector('.slot-nm').style.color='';\n    const ef=s.querySelector('.slot-eff');if(ef)ef.className='slot-eff';\n    const pi=$(`.pal-i[data-id=\"${dd.id}\"]`);if(pi)pi.classList.add('used');\n    dd=null;\n  });\n});\n\n// ── Misc ──\n$$('.char').forEach(c=>{c.addEventListener('click',()=>{$$('.char').forEach(x=>x.classList.remove('spk'));c.classList.add('spk')})});\n$$('.n-pin').forEach(p=>{p.addEventListener('click',e=>{e.stopPropagation();p.closest('.note').classList.toggle('pin')})});\n$('#dlg').scrollTop=$('#dlg').scrollHeight;\n\n// ═══ Feature 1: Typing Effect ═══\nlet typingActive=false;\nlet typingResolve=null;\nfunction typeMessage(element, text, speed){\n  if(speed===undefined)speed=typeof settingsTextSpeed!=='undefined'?settingsTextSpeed:30;\n  return new Promise(resolve=>{\n    typingActive=true;\n    typingResolve=resolve;\n    element.textContent='';\n    const cursor=document.createElement('span');\n    cursor.className='typing-cursor';\n    cursor.textContent='|';\n    element.appendChild(cursor);\n    let i=0;\n    const tick=()=>{\n      if(!typingActive){\n        // Skip: complete immediately\n        element.textContent=text;\n        typingActive=false;typingResolve=null;\n        resolve();return;\n      }\n      if(i<text.length){\n        cursor.remove();\n        element.appendChild(document.createTextNode(text[i]));\n        element.appendChild(cursor);\n        i++;\n        const dlg=$('#dlg');dlg.scrollTop=dlg.scrollHeight;\n        setTimeout(tick,speed);\n      }else{\n        cursor.remove();\n        typingActive=false;typingResolve=null;\n        resolve();\n      }\n    };\n    tick();\n  });\n}\n// Space to skip typing\ndocument.addEventListener('keydown',e=>{\n  if(e.key===' '&&typingActive){e.preventDefault();typingActive=false}\n});\n// Demo: type the last message on page load\n(function demoTyping(){\n  const msgs=$('#dlg').querySelectorAll('.msg');\n  const last=msgs[msgs.length-1];\n  if(!last)return;\n  const bubble=last.querySelector('.msg-text');\n  if(!bubble)return;\n  const fullText=bubble.textContent;\n  // Determine speed: check for bubble-angry (fast=20ms), bubble-resigned (slow=50ms), else normal=30ms\n  let speed=30;\n  if(bubble.classList.contains('bubble-angry'))speed=20;\n  else if(bubble.classList.contains('bubble-resigned'))speed=50;\n  typeMessage(bubble,fullText,speed);\n})();\n\n// ═══ Feature 3: Phase Transition ═══\nfunction showPhaseTransition(number,subtitle){\n  const pt=$('#pt');\n  pt.querySelector('.pt-number').textContent=number||'Phase 3';\n  pt.querySelector('.pt-subtitle').textContent=subtitle||'심문 — 진실을 추궁하라';\n  pt.classList.remove('fadeout');\n  pt.classList.add('active');\n  setTimeout(()=>{\n    pt.classList.add('fadeout');\n    setTimeout(()=>{pt.classList.remove('active','fadeout')},500);\n  },2300); // 0.3s fadein + 0.35s slam + 0.15s subtitle + 1.5s hold\n}\n// Press P to demo phase transition\ndocument.addEventListener('keydown',e=>{\n  if((e.key==='p'||e.key==='P')&&!e.ctrlKey&&!e.altKey&&!e.metaKey){\n    showPhaseTransition('Phase 3','심문 — 진실을 추궁하라');\n  }\n});\n\n// ═══ Feature 4: Dispute Accordion ═══\nconst disputeDetails={\n  '01':'관련 증거: 계좌 이체 내역, 카카오톡 대화 | 핵심 발언: T2, T4 | 현재 상태: S2 — 핑계 단계',\n  '02':'관련 증거: 계좌 이체 내역, 가계부 사본 | 핵심 발언: T4, T7 | 현재 상태: S1 — 일부 인정',\n  '03':'관련 증거: 동료 증언 | 핵심 발언: — | 현재 상태: S0 — 완전 부정',\n  '04':'관련 증거: 카카오톡 대화, 가계부 사본 | 핵심 발언: T4 | 현재 상태: S3 — 책임 전가',\n  '05':'관련 증거: 동료 증언, 통화 기록 | 핵심 발언: — | 현재 상태: S0 — 완전 부정'\n};\n$$('.dispute').forEach(d=>{\n  const detail=document.createElement('div');\n  detail.className='dispute-detail';\n  detail.textContent=disputeDetails[d.dataset.dispute]||'';\n  d.after(detail);\n  d.addEventListener('click',()=>{\n    const wasOpen=detail.classList.contains('open');\n    // Close all\n    $$('.dispute-detail').forEach(dd=>dd.classList.remove('open'));\n    if(!wasOpen)detail.classList.add('open');\n  });\n});\n\n// ═══ Feature 5: Evidence <-> Dispute Hover Highlight ═══\nconst evToDispute={\n  'ev-bank':['01','02'],\n  'ev-chat':['01','04'],\n  'ev-book':['02','04'],\n  'ev-cctv':['01'],\n  'ev-witness':['03','05'],\n  'ev-phone':['05'],\n  'ev-device':['01','02'],\n  'ev-sns':['03','05']\n};\n// Build reverse map: dispute -> evidence\nconst disputeToEv={};\nObject.entries(evToDispute).forEach(([ev,disputes])=>{\n  disputes.forEach(dId=>{\n    if(!disputeToEv[dId])disputeToEv[dId]=[];\n    disputeToEv[dId].push(ev);\n  });\n});\n\n$$('.ev-card').forEach(card=>{\n  const evId=card.dataset.evidence;\n  card.addEventListener('mouseenter',()=>{\n    const related=evToDispute[evId]||[];\n    related.forEach(dId=>{\n      const el=$$(`.dispute[data-dispute=\"${dId}\"]`);\n      el.forEach(d=>d.classList.add('highlight'));\n    });\n  });\n  card.addEventListener('mouseleave',()=>{\n    $$('.dispute.highlight').forEach(d=>d.classList.remove('highlight'));\n  });\n});\n\n$$('.dispute').forEach(d=>{\n  d.addEventListener('mouseenter',()=>{\n    const dId=d.dataset.dispute;\n    const related=disputeToEv[dId]||[];\n    related.forEach(evId=>{\n      const el=$$(`.ev-card[data-evidence=\"${evId}\"]`);\n      el.forEach(c=>c.classList.add('highlight'));\n    });\n  });\n  d.addEventListener('mouseleave',()=>{\n    $$('.ev-card.highlight').forEach(c=>c.classList.remove('highlight'));\n  });\n});\n\n// ═══ Feature 6: Note <-> Chat Message Highlight ═══\n$$('.note').forEach(note=>{\n  const turn=note.dataset.turn;\n  if(!turn)return;\n  note.addEventListener('mouseenter',()=>{\n    const msg=$$(`.msg[data-turn=\"${turn}\"]`);\n    msg.forEach(m=>{\n      m.classList.add('msg-highlight');\n      m.scrollIntoView({behavior:'smooth',block:'center'});\n    });\n  });\n  note.addEventListener('mouseleave',()=>{\n    $$('.msg.msg-highlight').forEach(m=>m.classList.remove('msg-highlight'));\n  });\n});\n\n// ═══ Feature 7: Meter Hover Tooltip ═══\nconst meterHistory={\n  'leak':'+15% (동기탐색, T5) → +10% (증거제시, T6)',\n  'contra':'+1 (사실추궁, T4) → +1 (증거제시, T7)',\n  'trust':'+10 (공감접근, T3)'\n};\nconst meterNames={'leak':'누설 미터','contra':'모순 토큰','trust':'신뢰 창구'};\n$$('.meter[data-meter]').forEach(m=>{\n  m.addEventListener('mouseenter',()=>{\n    const key=m.dataset.meter;\n    tt.querySelector('.tt-h').textContent=meterNames[key]||key;\n    tt.querySelector('.tt-d').textContent=meterHistory[key]||'';\n    tt.querySelector('.tt-c').textContent='최근 변동 이력';\n    const r=m.getBoundingClientRect();\n    tt.style.left=r.right+12+'px';\n    tt.style.top=r.top-10+'px';\n    tt.classList.add('vis');\n  });\n  m.addEventListener('mouseleave',()=>tt.classList.remove('vis'));\n});\n\n// ═══ Feature 8: Draggable Note Reordering ═══\n(function initNoteDrag(){\n  const noteList=$('.note-list');\n  let dragNote=null;\n\n  noteList.addEventListener('dragstart',e=>{\n    const note=e.target.closest('.note');\n    if(!note)return;\n    dragNote=note;\n    note.classList.add('dragging');\n    e.dataTransfer.effectAllowed='move';\n    e.dataTransfer.setData('text/plain','note');\n  });\n\n  noteList.addEventListener('dragend',e=>{\n    const note=e.target.closest('.note');\n    if(note)note.classList.remove('dragging');\n    $$('.note.drag-over-top,.note.drag-over-bottom').forEach(n=>{\n      n.classList.remove('drag-over-top','drag-over-bottom');\n    });\n    dragNote=null;\n  });\n\n  noteList.addEventListener('dragover',e=>{\n    e.preventDefault();\n    e.dataTransfer.dropEffect='move';\n    const target=e.target.closest('.note');\n    if(!target||target===dragNote)return;\n    // Clear all indicators\n    $$('.note.drag-over-top,.note.drag-over-bottom').forEach(n=>{\n      n.classList.remove('drag-over-top','drag-over-bottom');\n    });\n    // Determine top or bottom half\n    const rect=target.getBoundingClientRect();\n    const midY=rect.top+rect.height/2;\n    if(e.clientY<midY){\n      target.classList.add('drag-over-top');\n    }else{\n      target.classList.add('drag-over-bottom');\n    }\n  });\n\n  noteList.addEventListener('dragleave',e=>{\n    const target=e.target.closest('.note');\n    if(target){target.classList.remove('drag-over-top','drag-over-bottom')}\n  });\n\n  noteList.addEventListener('drop',e=>{\n    e.preventDefault();\n    const target=e.target.closest('.note');\n    if(!target||!dragNote||target===dragNote)return;\n    $$('.note.drag-over-top,.note.drag-over-bottom').forEach(n=>{\n      n.classList.remove('drag-over-top','drag-over-bottom');\n    });\n\n    // Check if both are pinned -> contradiction comparison\n    if(dragNote.classList.contains('pin')&&target.classList.contains('pin')){\n      showContradictionCompare(dragNote,target);\n      dragNote.classList.remove('dragging');\n      dragNote=null;\n      return;\n    }\n\n    // Reorder\n    const rect=target.getBoundingClientRect();\n    const midY=rect.top+rect.height/2;\n    if(e.clientY<midY){\n      noteList.insertBefore(dragNote,target);\n    }else{\n      noteList.insertBefore(dragNote,target.nextSibling);\n    }\n    dragNote.classList.remove('dragging');\n    dragNote=null;\n  });\n})();\n\n// ═══ Feature 9: Contradiction Comparison Mode ═══\nfunction showContradictionCompare(noteA,noteB){\n  const cc=$('#cc');\n  // Populate cards\n  $('#cc-turn-a').textContent='Turn '+noteA.dataset.turn;\n  $('#cc-speaker-a').textContent=noteA.dataset.speaker||'';\n  $('#cc-text-a').textContent='\"'+noteA.dataset.statement+'\"';\n  $('#cc-turn-b').textContent='Turn '+noteB.dataset.turn;\n  $('#cc-speaker-b').textContent=noteB.dataset.speaker||'';\n  $('#cc-text-b').textContent='\"'+noteB.dataset.statement+'\"';\n\n  // Assign card colors based on speaker side\n  const cardL=cc.querySelector('.cc-cards').children[0];\n  const cardR=cc.querySelector('.cc-cards').children[2];\n  cardL.className='cc-card';cardR.className='cc-card';\n  if(noteA.dataset.speaker&&noteA.dataset.speaker.includes('(A)')){\n    cardL.classList.add('cc-card-a');\n  }else{\n    cardL.classList.add('cc-card-b');\n  }\n  if(noteB.dataset.speaker&&noteB.dataset.speaker.includes('(A)')){\n    cardR.classList.add('cc-card-a');\n  }else{\n    cardR.classList.add('cc-card-b');\n  }\n\n  cc.classList.add('show');\n}\n\n$('#cc .cc-close').addEventListener('click',()=>$('#cc').classList.remove('show'));\n$('#cc-objection').addEventListener('click',()=>{\n  $('#cc').classList.remove('show');\n  $('#obj').classList.add('show');\n  setTimeout(()=>$('#obj').classList.remove('show'),3000);\n});\ndocument.addEventListener('keydown',e=>{\n  if(e.key==='Escape'&&$('#cc').classList.contains('show')){\n    $('#cc').classList.remove('show');\n  }\n});\n\n// ═══ Feature 10: Breaking Event Overlay ═══\nfunction showBreakingEvent(title,desc,iconId){\n  const be=$('#be');\n  if(title)$('#be-title').textContent=title;\n  if(desc)$('#be-desc').textContent=desc;\n  if(iconId){\n    be.querySelector('.be-icon use').setAttribute('href','#'+iconId);\n  }\n  be.classList.remove('fadeout');\n  be.classList.add('show');\n}\nfunction closeBreakingEvent(){\n  const be=$('#be');\n  be.classList.add('fadeout');\n  setTimeout(()=>be.classList.remove('show','fadeout'),300);\n}\n$('#be-allow').addEventListener('click',closeBreakingEvent);\n$('#be-restrain').addEventListener('click',closeBreakingEvent);\n\n// Press B to demo breaking event\ndocument.addEventListener('keydown',e=>{\n  if((e.key==='b'||e.key==='B')&&!e.ctrlKey&&!e.altKey&&!e.metaKey){\n    if($('#be').classList.contains('show'))return;\n    showBreakingEvent('감정 폭발!','박서연이 감정을 억누르지 못하고 폭발했습니다','i-flame');\n  }\n  if(e.key==='Escape'&&$('#be').classList.contains('show')){\n    closeBreakingEvent();\n  }\n  if(e.key==='Escape'&&$('#set-drawer').classList.contains('open')){\n    closeSettings();\n  }\n});\n\n// ═══ Settings Panel ═══\nlet settingsTextSpeed=30;\n\nfunction openSettings(){\n  $('#set-drawer').classList.add('open');\n  $('#set-backdrop').classList.add('open');\n}\nfunction closeSettings(){\n  $('#set-drawer').classList.remove('open');\n  $('#set-backdrop').classList.remove('open');\n}\nfunction toggleSettings(){\n  if($('#set-drawer').classList.contains('open'))closeSettings();\n  else openSettings();\n}\n\n$('#gear-btn').addEventListener('click',toggleSettings);\n$('#set-close').addEventListener('click',closeSettings);\n$('#set-backdrop').addEventListener('click',closeSettings);\n\n// UI Scale\n$('#set-scale').addEventListener('input',e=>{\n  const v=e.target.value;\n  $('#set-scale-val').textContent=v+'%';\n  document.documentElement.style.fontSize=(15*v/100)+'px';\n});\n\n// Text Speed\n$$('#set-speed .set-tog').forEach(btn=>{\n  btn.addEventListener('click',()=>{\n    $$('#set-speed .set-tog').forEach(b=>b.classList.remove('active'));\n    btn.classList.add('active');\n    settingsTextSpeed=parseInt(btn.dataset.speed,10);\n  });\n});\n\n// BGM Volume\n$('#set-bgm').addEventListener('input',e=>{\n  $('#set-bgm-val').textContent=e.target.value+'%';\n});\n\n// SFX Volume\n$('#set-sfx').addEventListener('input',e=>{\n  $('#set-sfx-val').textContent=e.target.value+'%';\n});\n\n// Fullscreen\n$('#set-fs').addEventListener('click',()=>{\n  if(!document.fullscreenElement){\n    document.documentElement.requestFullscreen().catch(()=>{});\n    $('#set-fs').textContent='창 모드';\n    $('#set-fs').classList.add('active');\n  }else{\n    document.exitFullscreen();\n    $('#set-fs').textContent='전체화면';\n    $('#set-fs').classList.remove('active');\n  }\n});\ndocument.addEventListener('fullscreenchange',()=>{\n  if(!document.fullscreenElement){\n    $('#set-fs').textContent='전체화면';\n    $('#set-fs').classList.remove('active');\n  }\n});\n\n// ═══ Feature 11: Verdict Screen (2-Step) ═══\nfunction verdictResetToStep1(){\n  $('#verdict-step-1').classList.remove('hidden');\n  $('#verdict-step-2').classList.remove('active');\n}\nfunction openVerdict(){\n  const v=$('#verdict');\n  if(v.classList.contains('show'))return;\n  v.classList.remove('fadeout');\n  verdictResetToStep1();\n  v.classList.add('show');\n  updateVerdictSlider();\n}\nfunction closeVerdict(){\n  const v=$('#verdict');\n  v.classList.add('fadeout');\n  setTimeout(()=>{v.classList.remove('show','fadeout');verdictResetToStep1()},300);\n}\n\n$('#verdict-close').addEventListener('click',closeVerdict);\n\n// Step navigation\n$('#verdict-next-btn').addEventListener('click',function(){\n  // Update step 2 summary with current slider values\n  const val=parseInt($('#verdict-slider').value,10);\n  const bVal=100-val;\n  $('#verdict-step2-summary').innerHTML='책임 배분: <b>최민준 '+val+'%</b> · <b class=\"red\">박서연 '+bVal+'%</b>';\n  // Transition\n  $('#verdict-step-1').classList.add('hidden');\n  $('#verdict-step-2').classList.add('active');\n});\n$('#verdict-back-btn').addEventListener('click',function(){\n  $('#verdict-step-2').classList.remove('active');\n  $('#verdict-step-1').classList.remove('hidden');\n});\n\n// Slider logic\nfunction updateVerdictSlider(){\n  const slider=$('#verdict-slider');\n  const val=parseInt(slider.value,10);\n  const aPercent=val;\n  const bPercent=100-val;\n\n  // Update percentages\n  $('#verdict-pct-a').textContent=aPercent+'%';\n  $('#verdict-pct-b').textContent=bPercent+'%';\n\n  // Update beam tilt: (value - 50) * 0.3 degrees\n  const angle=(val-50)*0.3;\n  $('#verdict-beam').style.transform='rotate('+angle+'deg)';\n\n  // Update character A face\n  const faceA=$('#verdict-face-a');\n  if(aPercent>60){\n    faceA.querySelector('use').setAttribute('href','#i-man-defensive');\n  }else if(aPercent<40){\n    faceA.querySelector('use').setAttribute('href','#i-man-confident');\n  }else{\n    faceA.querySelector('use').setAttribute('href','#i-man-confident');\n  }\n\n  // Update character B face\n  const faceB=$('#verdict-face-b');\n  if(bPercent>60){\n    faceB.querySelector('use').setAttribute('href','#i-woman-angry');\n  }else if(bPercent<40){\n    faceB.querySelector('use').setAttribute('href','#i-woman-shaken');\n  }else{\n    faceB.querySelector('use').setAttribute('href','#i-woman-shaken');\n  }\n}\n\n$('#verdict-slider').addEventListener('input',updateVerdictSlider);\n\n// Solution card selection\n$$('.verdict-card').forEach(card=>{\n  card.addEventListener('click',()=>{\n    // Deselect all\n    $$('.verdict-card').forEach(c=>c.classList.remove('selected'));\n    // Select this one\n    card.classList.add('selected');\n  });\n  // Button click triggers selection then closes\n  card.querySelector('.verdict-card-btn').addEventListener('click',e=>{\n    e.stopPropagation();\n    $$('.verdict-card').forEach(c=>c.classList.remove('selected'));\n    card.classList.add('selected');\n    // Delay close for selection animation\n    setTimeout(closeVerdict,600);\n  });\n});\n\n// V key to open verdict\ndocument.addEventListener('keydown',e=>{\n  if((e.key==='v'||e.key==='V')&&!e.ctrlKey&&!e.altKey&&!e.metaKey){\n    if($('#verdict').classList.contains('show'))return;\n    openVerdict();\n  }\n  if(e.key==='Escape'&&$('#verdict').classList.contains('show')){\n    closeVerdict();\n  }\n});\n\n// ═══ Feature 12: Focus Mode ═══\n(function initFocusMode(){\n  const app=$('.app');\n  const panelL=$('.panel-l');\n  const panelR=$('.panel-r');\n  const toggleL=$('#toggle-l');\n  const toggleR=$('#toggle-r');\n  const stripL=$('#strip-l');\n  const stripR=$('#strip-r');\n\n  // Focus state: 0=normal, 1=left collapsed, 2=both collapsed\n  let focusState=0;\n\n  function updateFocusClasses(){\n    app.classList.remove('left-collapsed','right-collapsed','both-collapsed');\n    panelL.classList.remove('collapsed');\n    panelR.classList.remove('collapsed');\n\n    const leftCollapsed=focusState===1||focusState===2;\n    const rightCollapsed=focusState===2;\n\n    if(leftCollapsed&&rightCollapsed){\n      app.classList.add('both-collapsed');\n    }else if(leftCollapsed){\n      app.classList.add('left-collapsed');\n    }else if(rightCollapsed){\n      app.classList.add('right-collapsed');\n    }\n\n    if(leftCollapsed)panelL.classList.add('collapsed');\n    if(rightCollapsed)panelR.classList.add('collapsed');\n\n    // Update toggle button arrows\n    toggleL.innerHTML=leftCollapsed?'&rsaquo;':'&lsaquo;';\n    toggleR.innerHTML=rightCollapsed?'&lsaquo;':'&rsaquo;';\n  }\n\n  // F key cycles: normal -> left collapsed -> both collapsed -> normal\n  document.addEventListener('keydown',function(e){\n    if((e.key==='f'||e.key==='F')&&!e.ctrlKey&&!e.altKey&&!e.metaKey){\n      // Don't trigger if typing in an input\n      if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA')return;\n      e.preventDefault();\n      focusState=(focusState+1)%3;\n      updateFocusClasses();\n    }\n  });\n\n  // Individual panel toggle buttons\n  toggleL.addEventListener('click',function(){\n    const isCollapsed=panelL.classList.contains('collapsed');\n    if(isCollapsed){\n      // Expand left\n      if(focusState===1)focusState=0;\n      else if(focusState===2)focusState=0; // expand left, also expand right\n    }else{\n      // Collapse left\n      if(focusState===0)focusState=1;\n    }\n    // Recalculate: check actual desired state\n    const leftWant=focusState===1||focusState===2;\n    const rightWant=focusState===2;\n    app.classList.remove('left-collapsed','right-collapsed','both-collapsed');\n    panelL.classList.remove('collapsed');\n    panelR.classList.remove('collapsed');\n    if(leftWant)panelL.classList.add('collapsed');\n    if(rightWant)panelR.classList.add('collapsed');\n    if(leftWant&&rightWant)app.classList.add('both-collapsed');\n    else if(leftWant)app.classList.add('left-collapsed');\n    else if(rightWant)app.classList.add('right-collapsed');\n    toggleL.innerHTML=leftWant?'&rsaquo;':'&lsaquo;';\n    toggleR.innerHTML=rightWant?'&lsaquo;':'&rsaquo;';\n  });\n\n  toggleR.addEventListener('click',function(){\n    const isCollapsed=panelR.classList.contains('collapsed');\n    if(isCollapsed){\n      // Expand right\n      panelR.classList.remove('collapsed');\n      app.classList.remove('both-collapsed','right-collapsed');\n      if(panelL.classList.contains('collapsed'))app.classList.add('left-collapsed');\n    }else{\n      // Collapse right\n      panelR.classList.add('collapsed');\n      if(panelL.classList.contains('collapsed')){\n        app.classList.remove('left-collapsed');\n        app.classList.add('both-collapsed');\n      }else{\n        app.classList.add('right-collapsed');\n      }\n    }\n    // Sync focusState\n    const lc=panelL.classList.contains('collapsed');\n    const rc=panelR.classList.contains('collapsed');\n    if(lc&&rc)focusState=2;\n    else if(lc)focusState=1;\n    else focusState=0;\n    toggleL.innerHTML=lc?'&rsaquo;':'&lsaquo;';\n    toggleR.innerHTML=rc?'&lsaquo;':'&rsaquo;';\n  });\n\n  // Click on collapsed strip to expand\n  stripL.addEventListener('click',function(){\n    if(!panelL.classList.contains('collapsed'))return;\n    panelL.classList.remove('collapsed');\n    app.classList.remove('left-collapsed','both-collapsed');\n    const rc=panelR.classList.contains('collapsed');\n    if(rc)app.classList.add('right-collapsed');\n    focusState=0;\n    toggleL.innerHTML='&lsaquo;';\n  });\n\n  stripR.addEventListener('click',function(){\n    if(!panelR.classList.contains('collapsed'))return;\n    panelR.classList.remove('collapsed');\n    app.classList.remove('right-collapsed','both-collapsed');\n    const lc=panelL.classList.contains('collapsed');\n    if(lc)app.classList.add('left-collapsed');\n    focusState=lc?1:0;\n    toggleR.innerHTML='&rsaquo;';\n  });\n})();\n\n// ═══ Collapsible Sections (Judge Profile + Timeline) ═══\n$$('.sec.collapsible .sec-h').forEach(function(header){\n  header.addEventListener('click',function(){\n    const sec=header.closest('.sec');\n    sec.classList.toggle('sec-closed');\n  });\n});\n\n// ═══ Feature 13: Click-to-Lock Highlights ═══\n(function initClickToLock(){\n  // Add lock indicator dots to ev-cards, disputes, and notes\n  $$('.ev-card').forEach(el=>{const d=document.createElement('span');d.className='locked-indicator';el.appendChild(d)});\n  $$('.dispute').forEach(el=>{const d=document.createElement('span');d.className='locked-indicator';el.appendChild(d)});\n  $$('.note').forEach(el=>{const d=document.createElement('span');d.className='locked-indicator';el.appendChild(d)});\n\n  function clearAllLocks(){\n    $$('.ev-card.locked').forEach(c=>c.classList.remove('locked'));\n    $$('.dispute.locked').forEach(d=>d.classList.remove('locked'));\n    $$('.note.note-locked').forEach(n=>n.classList.remove('note-locked'));\n    $$('.msg.msg-locked').forEach(m=>m.classList.remove('msg-locked'));\n  }\n\n  // Click on ev-card: lock related dispute highlights\n  $$('.ev-card').forEach(card=>{\n    card.addEventListener('click',function(e){\n      e.stopPropagation();\n      const wasLocked=card.classList.contains('locked');\n      clearAllLocks();\n      if(wasLocked)return;\n      card.classList.add('locked');\n      const evId=card.dataset.evidence;\n      const related=evToDispute[evId]||[];\n      related.forEach(dId=>{\n        $$(`.dispute[data-dispute=\"${dId}\"]`).forEach(d=>d.classList.add('locked'));\n      });\n    });\n  });\n\n  // Click on dispute: lock related evidence highlights\n  $$('.dispute').forEach(d=>{\n    d.addEventListener('click',function(e){\n      e.stopPropagation();\n      const wasLocked=d.classList.contains('locked');\n      clearAllLocks();\n      if(wasLocked)return;\n      d.classList.add('locked');\n      const dId=d.dataset.dispute;\n      const related=disputeToEv[dId]||[];\n      related.forEach(evId=>{\n        $$(`.ev-card[data-evidence=\"${evId}\"]`).forEach(c=>c.classList.add('locked'));\n      });\n    });\n  });\n\n  // Click on note: lock and highlight corresponding chat message + auto-scroll\n  $$('.note').forEach(note=>{\n    note.addEventListener('click',function(e){\n      // Don't lock if clicking the pin icon or if shift is held (comparison tray)\n      if(e.target.closest('.n-pin'))return;\n      if(e.shiftKey)return;\n      e.stopPropagation();\n      const turn=note.dataset.turn;\n      if(!turn)return;\n      const wasLocked=note.classList.contains('note-locked');\n      clearAllLocks();\n      if(wasLocked)return;\n      note.classList.add('note-locked');\n      const msgs=$$(`.msg[data-turn=\"${turn}\"]`);\n      msgs.forEach(m=>{\n        m.classList.add('msg-locked');\n        m.scrollIntoView({behavior:'smooth',block:'center'});\n      });\n    });\n  });\n\n  // Clear locks on clicking empty areas\n  document.addEventListener('click',function(e){\n    // If click was on a lockable element, it handled stopPropagation\n    // Otherwise clear all locks\n    if(!e.target.closest('.ev-card')&&!e.target.closest('.dispute')&&!e.target.closest('.note')){\n      clearAllLocks();\n    }\n  });\n\n  // Escape clears locks\n  document.addEventListener('keydown',function(e){\n    if(e.key==='Escape'){clearAllLocks()}\n  });\n})();\n\n// ═══ Feature 14: Comparison Tray ═══\n(function initCompareTray(){\n  const slotA={el:$('#cs-a'),data:null};\n  const slotB={el:$('#cs-b'),data:null};\n  const compareBtn=$('#compare-btn');\n\n  function updateSlotUI(slot){\n    const textEl=slot.el.querySelector('.cs-text');\n    const clearEl=slot.el.querySelector('.cs-clear');\n    if(slot.data){\n      textEl.textContent='T'+slot.data.turn+': '+slot.data.statement.substring(0,20)+'...';\n      clearEl.style.display='';\n      slot.el.classList.add('filled');\n    }else{\n      textEl.textContent='비어있음';\n      clearEl.style.display='none';\n      slot.el.classList.remove('filled');\n    }\n    compareBtn.style.display=(slotA.data&&slotB.data)?'':'none';\n  }\n\n  function addToTray(noteEl){\n    const data={\n      turn:noteEl.dataset.turn,\n      speaker:noteEl.dataset.speaker||'',\n      statement:noteEl.dataset.statement||''\n    };\n    if(!slotA.data){\n      slotA.data=data;updateSlotUI(slotA);\n    }else if(!slotB.data){\n      slotB.data=data;updateSlotUI(slotB);\n    }else{\n      // Both full: replace A\n      slotA.data=data;updateSlotUI(slotA);\n    }\n  }\n\n  // Shift+Click on note adds to tray\n  $$('.note').forEach(note=>{\n    note.addEventListener('click',function(e){\n      if(!e.shiftKey)return;\n      e.stopPropagation();\n      addToTray(note);\n    });\n  });\n\n  // Clear buttons\n  slotA.el.querySelector('.cs-clear').addEventListener('click',function(e){\n    e.stopPropagation();\n    slotA.data=null;updateSlotUI(slotA);\n  });\n  slotB.el.querySelector('.cs-clear').addEventListener('click',function(e){\n    e.stopPropagation();\n    slotB.data=null;updateSlotUI(slotB);\n  });\n\n  // Compare button opens contradiction compare overlay\n  compareBtn.addEventListener('click',function(){\n    if(!slotA.data||!slotB.data)return;\n    const cc=$('#cc');\n    $('#cc-turn-a').textContent='Turn '+slotA.data.turn;\n    $('#cc-speaker-a').textContent=slotA.data.speaker;\n    $('#cc-text-a').textContent='\"'+slotA.data.statement+'\"';\n    $('#cc-turn-b').textContent='Turn '+slotB.data.turn;\n    $('#cc-speaker-b').textContent=slotB.data.speaker;\n    $('#cc-text-b').textContent='\"'+slotB.data.statement+'\"';\n    // Card colors based on speaker\n    const cardL=cc.querySelector('.cc-cards').children[0];\n    const cardR=cc.querySelector('.cc-cards').children[2];\n    cardL.className='cc-card';cardR.className='cc-card';\n    cardL.classList.add(slotA.data.speaker.includes('(A)')?'cc-card-a':'cc-card-b');\n    cardR.classList.add(slotB.data.speaker.includes('(A)')?'cc-card-a':'cc-card-b');\n    cc.classList.add('show');\n  });\n\n  updateSlotUI(slotA);\n  updateSlotUI(slotB);\n})();\n\n// ═══ Feature 15: Recent Changes Log ═══\n(function initChangesLog(){\n  const toggle=$('#changes-toggle');\n  const body=$('#changes-body');\n  const dot=$('#changes-dot');\n  let isOpen=false;\n\n  toggle.addEventListener('click',function(){\n    isOpen=!isOpen;\n    body.classList.toggle('open',isOpen);\n    if(isOpen)dot.classList.add('read');\n  });\n})();\n\n// ═══ Feature 16: Tiered Event System ═══\n\n// --- Tier 1: Minor Event Banner ---\nconst bannerStack=[];\nfunction showMinorBanner(text, choices){\n  const center=document.querySelector('.center');\n  const banner=document.createElement('div');\n  banner.className='event-banner';\n  let actionsHtml='';\n  if(choices&&choices.length){\n    actionsHtml='<div class=\"eb-actions\">'+choices.map(c=>'<button class=\"eb-btn\">'+c+'</button>').join('')+'</div>';\n  }\n  banner.innerHTML='<span class=\"eb-icon\">💬</span><span class=\"eb-text\">'+text+'</span>'+actionsHtml;\n\n  // Stack management: max 2\n  if(bannerStack.length>=2){\n    dismissBanner(bannerStack[0]);\n  }\n  // Push older banners up\n  bannerStack.forEach((b,i)=>{\n    b.style.bottom=(64*(bannerStack.length-i))+'px';\n  });\n\n  center.appendChild(banner);\n  bannerStack.push(banner);\n\n  // Force reflow then show\n  banner.offsetHeight;\n  banner.classList.add('show');\n\n  // Button handlers\n  banner.querySelectorAll('.eb-btn').forEach(btn=>{\n    btn.addEventListener('click',()=>dismissBanner(banner));\n  });\n\n  // Auto-dismiss after 5s\n  banner._timer=setTimeout(()=>dismissBanner(banner),5000);\n}\n\nfunction dismissBanner(banner){\n  if(!banner||!banner.parentNode)return;\n  clearTimeout(banner._timer);\n  banner.classList.remove('show');\n  banner.classList.add('dismiss');\n  const idx=bannerStack.indexOf(banner);\n  if(idx>-1)bannerStack.splice(idx,1);\n  // Reposition remaining\n  bannerStack.forEach((b,i)=>{\n    b.style.bottom=(i>0?(64*i):0)+'px';\n  });\n  setTimeout(()=>{if(banner.parentNode)banner.parentNode.removeChild(banner);},400);\n}\n\n// --- Tier 2: Chat-Inline Choice Card ---\nfunction insertChoiceCard(text, choices){\n  const dlg=$('#dlg');\n  const card=document.createElement('div');\n  card.className='chat-choice-card';\n  let btnsHtml=choices.map(c=>'<button class=\"choice-btn\">'+c+'</button>').join('');\n  card.innerHTML='<span class=\"ccc-icon\">⚖️</span><div class=\"ccc-text\">'+text+'</div><div class=\"ccc-actions\">'+btnsHtml+'</div>';\n\n  card.querySelectorAll('.choice-btn').forEach(btn=>{\n    btn.addEventListener('click',()=>{\n      btn.classList.add('selected');\n      card.classList.add('chosen');\n    });\n  });\n\n  dlg.appendChild(card);\n  card.scrollIntoView({behavior:'smooth',block:'end'});\n}\n\n// --- Demo Triggers ---\ndocument.addEventListener('keydown',e=>{\n  if(e.ctrlKey||e.altKey||e.metaKey)return;\n  if(e.key==='n'||e.key==='N'){\n    showMinorBanner('박서연이 끼어들려 합니다',['허용','무시']);\n  }\n  if(e.key==='m'||e.key==='M'){\n    insertChoiceCard('쟁점 d-3이 새로 발현되었습니다',['집중 조사','나중에']);\n  }\n});\n\n/* ═══ Feature: Evidence Detail Viewer ═══ */\n(function(){\n  const backdrop=$('#ev-backdrop'), viewer=$('#ev-viewer'),\n        header=$('#ev-viewer-header'), body=$('#ev-viewer-body'),\n        closeBtn=$('#ev-viewer-close');\n\n  /* --- Type mapping --- */\n  const typeMap={\n    'ev-bank':'bank','ev-chat':'chat','ev-book':'contract','ev-witness':'testimony',\n    'ev-cctv':'cctv','ev-phone':'log','ev-device':'device','ev-sns':'sns'\n  };\n\n  /* --- Meta data per evidence --- */\n  const evidenceMeta={\n    'ev-bank':{name:'계좌 이체 내역',icon:'i-doc',trust:'high',trustLabel:'높음',source:'org',sourceLabel:'기관',legal:'ok',legalLabel:'적법',stage:2},\n    'ev-chat':{name:'카카오톡 대화',icon:'i-chat',trust:'mid',trustLabel:'보통',source:'a',sourceLabel:'A측',legal:'sus',legalLabel:'의심',stage:1},\n    'ev-book':{name:'가계부 사본',icon:'i-ledger',trust:'mid',trustLabel:'보통',source:'a',sourceLabel:'A측',legal:'ok',legalLabel:'적법',stage:2},\n    'ev-witness':{name:'동료 증언',icon:'i-person',trust:'mid',trustLabel:'보통',source:'third',sourceLabel:'제3자',legal:'ok',legalLabel:'적법',stage:1},\n    'ev-cctv':{name:'CCTV 캡처',icon:'i-cam',trust:'high',trustLabel:'높음',source:'org',sourceLabel:'기관',legal:'ok',legalLabel:'적법',stage:1},\n    'ev-phone':{name:'통화 기록',icon:'i-phone',trust:'high',trustLabel:'높음',source:'org',sourceLabel:'기관',legal:'ok',legalLabel:'적법',stage:2},\n    'ev-device':{name:'최민준 휴대폰',icon:'i-smartphone',trust:'high',trustLabel:'높음',source:'a',sourceLabel:'A측',legal:'ok',legalLabel:'적법',stage:2},\n    'ev-sns':{name:'SNS 게시글',icon:'i-sns',trust:'low',trustLabel:'낮음',source:'third',sourceLabel:'제3자',legal:'sus',legalLabel:'의심',stage:1}\n  };\n\n  function openEvidenceViewer(evId){\n    const type=typeMap[evId];\n    if(!type)return;\n    const meta=evidenceMeta[evId];\n    if(!meta)return;\n\n    /* Build header */\n    header.innerHTML=`\n      <div class=\"ev-viewer-icon\"><svg><use href=\"#${meta.icon}\"/></svg></div>\n      <span class=\"ev-viewer-name\">${meta.name}</span>\n      <div class=\"ev-viewer-tags\">\n        <span class=\"ev-tag ev-tag-trust-${meta.trust}\">신뢰도: ${meta.trustLabel}</span>\n        <span class=\"ev-tag ev-tag-source-${meta.source}\">출처: ${meta.sourceLabel}</span>\n        <span class=\"ev-tag ev-tag-legal-${meta.legal}\">적법성: ${meta.legalLabel}</span>\n        <span class=\"ev-tag ev-tag-stage\">공개단계: stage ${meta.stage}</span>\n      </div>`;\n\n    /* Build body by type */\n    const builders={bank:buildBank,chat:buildChat,contract:buildContract,testimony:buildTestimony,cctv:buildCCTV,log:buildLog,device:buildDevice,sns:buildSNS};\n    body.innerHTML='';\n    builders[type](body);\n\n    backdrop.classList.add('open');\n    viewer.classList.add('open');\n  }\n\n  function closeEvidenceViewer(){\n    backdrop.classList.remove('open');\n    viewer.classList.remove('open');\n  }\n\n  closeBtn.addEventListener('click',closeEvidenceViewer);\n  backdrop.addEventListener('click',closeEvidenceViewer);\n  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeEvidenceViewer()});\n\n  /* Double-click on ev-cards */\n  $$('.ev-card').forEach(card=>{\n    card.addEventListener('dblclick',e=>{\n      e.preventDefault();\n      openEvidenceViewer(card.dataset.id);\n    });\n  });\n\n  /* ────── Bank ────── */\n  function buildBank(container){\n    const rows=[\n      {date:'2025.09.01',desc:'급여 입금',amount:'+350만원',balance:'470만',suspicious:false},\n      {date:'2025.09.05',desc:'A\\u2192? 이체',amount:'-280만원',balance:'190만',suspicious:true},\n      {date:'2025.09.08',desc:'카드 결제 (식비)',amount:'-12만원',balance:'178만',suspicious:false},\n      {date:'2025.09.12',desc:'A\\u2192? 이체',amount:'-150만원',balance:'28만',suspicious:true},\n      {date:'2025.09.15',desc:'관리비 자동이체',amount:'-15만원',balance:'13만',suspicious:false},\n      {date:'2025.09.20',desc:'급여 입금',amount:'+350만원',balance:'363만',suspicious:false},\n      {date:'2025.09.25',desc:'A\\u2192? 이체',amount:'-200만원',balance:'163만',suspicious:true},\n      {date:'2025.09.28',desc:'카드 결제 (교육비)',amount:'-30만원',balance:'133만',suspicious:false},\n    ];\n    let html=`<table class=\"ev-bank-table\"><thead><tr><th>날짜</th><th>내용</th><th>금액</th><th>잔액</th></tr></thead><tbody>`;\n    rows.forEach(r=>{\n      const cls=r.suspicious?' class=\"suspicious\"':'';\n      const neg=r.amount.startsWith('-');\n      const amtCls=neg?'amt-neg':'amt-pos';\n      const tooltip=r.suspicious?'<span class=\"ev-bank-tooltip\">이 거래를 추궁하시겠습니까?</span>':'';\n      html+=`<tr${cls}><td>${r.date}</td><td>${r.desc}${tooltip}</td><td class=\"${amtCls}\">${r.amount}</td><td>${r.balance}</td></tr>`;\n    });\n    html+=`</tbody></table>`;\n    container.innerHTML=html;\n  }\n\n  /* ────── Chat ────── */\n  function buildChat(container){\n    const msgs=[\n      {side:'left',sender:'최민준',text:'이번 달 좀 빠듯해'},\n      {side:'right',sender:'박서연',text:'또? 지난달도 그랬잖아'},\n      {side:'left',sender:'최민준',text:'경조사가 좀 있었어'},\n      {side:'right',sender:'박서연',text:'누구 경조사인데?'},\n      {side:'left',sender:'최민준',text:'회사 선배... 결혼이랑 장례식'},\n      {type:'deleted',text:'삭제된 메시지 3건'},\n      {side:'right',sender:'박서연',text:'가계부 좀 보여줘'},\n      {type:'read',text:'최민준 \\u2014 읽음'},\n      {side:'right',sender:'박서연',text:'왜 답이 없어?'},\n      {side:'left',sender:'최민준',text:'지금 바빠 나중에 얘기하자'},\n      {side:'right',sender:'박서연',text:'맨날 나중에래'},\n    ];\n    let html=`<div class=\"ev-chat-header\">카카오톡 대화 기록 \\u2014 2025.09.10~09.25</div><div class=\"ev-chat-log\">`;\n    msgs.forEach(m=>{\n      if(m.type==='deleted'){\n        html+=`<div class=\"ev-chat-deleted\">\\u00B7\\u00B7\\u00B7 [${m.text}] \\u00B7\\u00B7\\u00B7</div>`;\n      }else if(m.type==='read'){\n        html+=`<div class=\"ev-chat-read\"><svg style=\"width:14px;height:14px;color:var(--t3)\"><use href=\"#i-eye\"/></svg>${m.text}</div>`;\n      }else{\n        const cls=m.side==='left'?'ev-chat-left':'ev-chat-right';\n        html+=`<div class=\"ev-chat-bubble ${cls}\"><div class=\"ev-chat-sender\">${m.sender}</div>${m.text}</div>`;\n      }\n    });\n    html+=`</div>`;\n    container.innerHTML=html;\n  }\n\n  /* ────── Contract / Ledger ────── */\n  function buildContract(container){\n    const rows=[\n      {date:'09/01',content:'식비',amount:'-45만원',missing:false},\n      {date:'09/05',content:'[기재 없음]',amount:'',missing:true},\n      {date:'09/08',content:'교통비',amount:'-8만원',missing:false},\n      {date:'09/10',content:'관리비',amount:'-12만원',missing:false},\n      {date:'09/12',content:'[기재 없음]',amount:'',missing:true},\n      {date:'09/15',content:'교육비',amount:'-30만원',missing:false},\n      {date:'09/18',content:'보험료',amount:'-15만원',missing:false},\n      {date:'09/20',content:'식비',amount:'-38만원',missing:false},\n      {date:'09/25',content:'[기재 없음]',amount:'',missing:true},\n      {date:'09/28',content:'의류',amount:'-7만원',missing:false},\n    ];\n    let html=`<div class=\"ev-doc-paper\">\n      <div class=\"ev-doc-title\">가 계 부</div>\n      <div class=\"ev-doc-subtitle\">2025년 9월</div>`;\n    rows.forEach(r=>{\n      const cls=r.missing?' missing':'';\n      html+=`<div class=\"ev-doc-row${cls}\">\n        <span class=\"ev-doc-date\">${r.date}</span>\n        <span class=\"ev-doc-content\">${r.content}</span>\n        <span class=\"ev-doc-amount\">${r.amount}</span>\n      </div>`;\n    });\n    html+=`<div class=\"ev-doc-signature\">\\u2500\\u2500\\u2500 서명: 최민준 \\u2500\\u2500\\u2500 날짜: 2025.09.30 \\u2500\\u2500\\u2500</div></div>`;\n    container.innerHTML=html;\n  }\n\n  /* ────── Testimony ────── */\n  function buildTestimony(container){\n    container.innerHTML=`\n      <div class=\"ev-witness-info\"><strong>증인: 김태호</strong> (직장 동료, 5년 근무)</div>\n      <div class=\"ev-witness-quote\">최민준 씨가 9월에 급하게 돈이 필요하다고 했습니다. 경조사라고 했는데, 구체적으로 누구 경조사인지는 말하지 않았습니다. 평소와 달리 좀 초조해 보였고, 점심시간에 자주 전화를 받으러 나갔습니다.</div>\n      <div class=\"ev-witness-tags\">\n        <div class=\"ev-witness-tag\">\n          <span class=\"ev-witness-tag-label\">확신도</span>\n          <span class=\"ev-witness-tag-value ev-witness-tag-high\">높음</span>\n        </div>\n        <div class=\"ev-witness-tag\">\n          <span class=\"ev-witness-tag-label\">편향도</span>\n          <span class=\"ev-witness-tag-value ev-witness-tag-neutral\">중립</span>\n        </div>\n        <div class=\"ev-witness-tag\">\n          <span class=\"ev-witness-tag-label\">직접 목격</span>\n          <span class=\"ev-witness-tag-value ev-witness-tag-no\">아니오</span>\n        </div>\n      </div>\n      <div class=\"ev-witness-related\" id=\"ev-witness-link\">\n        <svg style=\"width:14px;height:14px\"><use href=\"#i-pin\"/></svg>\n        관련 발언: T7 \"경조사비 + 영수증\"\n      </div>`;\n    /* Click on related link: close viewer and highlight note T7 */\n    const link=$('#ev-witness-link');\n    if(link){\n      link.addEventListener('click',()=>{\n        closeEvidenceViewer();\n        const notes=$$('.note .n-t');\n        notes.forEach(n=>{\n          if(n.textContent.trim()==='T7'){\n            const note=n.closest('.note');\n            if(note){\n              note.scrollIntoView({behavior:'smooth',block:'center'});\n              note.style.outline='2px solid var(--gold)';\n              note.style.boxShadow='0 0 16px rgba(212,162,78,.2)';\n              setTimeout(()=>{note.style.outline='';note.style.boxShadow=''},2500);\n            }\n          }\n        });\n      });\n    }\n  }\n\n  /* ────── CCTV ────── */\n  function buildCCTV(container){\n    const events=[\n      {time:'22:10',pct:0,  label:'입장',  desc:'최민준이 은행에 입장합니다',icon:'i-person',suspicious:false},\n      {time:'22:15',pct:33, label:'ATM 접근',desc:'ATM 기기 앞에 서있습니다',icon:'i-search',suspicious:true},\n      {time:'22:18',pct:53, label:'출금',  desc:'현금을 인출합니다. 금액: 200만원',icon:'i-doc',suspicious:true},\n      {time:'22:20',pct:67, label:'퇴장',  desc:'은행을 떠납니다',icon:'i-person',suspicious:false},\n    ];\n    let cur=0;\n\n    function render(){\n      const ev=events[cur];\n      const suspCls=ev.suspicious?' suspicious':'';\n      let markersHtml='';\n      let labelsHtml='';\n      events.forEach((e,i)=>{\n        const actCls=i===cur?' active':'';\n        markersHtml+=`<div class=\"ev-cctv-marker${actCls}\" data-idx=\"${i}\" style=\"left:${e.pct}%\"></div>`;\n        labelsHtml+=`<span class=\"ev-cctv-label${actCls}\" data-idx=\"${i}\">${e.label}</span>`;\n      });\n      container.innerHTML=`\n        <div class=\"ev-cctv-frame\">\n          <span class=\"ev-cctv-time\">${ev.time}</span>\n          <div class=\"ev-cctv-icon\"><svg><use href=\"#${ev.icon}\"/></svg></div>\n          <div class=\"ev-cctv-desc${suspCls}\">${ev.desc}</div>\n        </div>\n        <div class=\"ev-cctv-timeline\">\n          <div class=\"ev-cctv-track\">\n            <div class=\"ev-cctv-fill\" style=\"width:${ev.pct}%\"></div>\n            <div class=\"ev-cctv-markers\">${markersHtml}</div>\n          </div>\n          <div class=\"ev-cctv-labels\">${labelsHtml}</div>\n        </div>\n        <div class=\"ev-cctv-btns\">\n          <button class=\"ev-cctv-btn\" id=\"cctv-prev\">\\u2190 이전 프레임</button>\n          <button class=\"ev-cctv-btn\" id=\"cctv-next\">다음 프레임 \\u2192</button>\n        </div>`;\n\n      /* Bind events */\n      container.querySelector('#cctv-prev').addEventListener('click',()=>{if(cur>0){cur--;render()}});\n      container.querySelector('#cctv-next').addEventListener('click',()=>{if(cur<events.length-1){cur++;render()}});\n      container.querySelectorAll('.ev-cctv-marker').forEach(m=>{\n        m.addEventListener('click',()=>{cur=parseInt(m.dataset.idx);render()});\n      });\n      container.querySelectorAll('.ev-cctv-label').forEach(l=>{\n        l.addEventListener('click',()=>{cur=parseInt(l.dataset.idx);render()});\n        l.style.cursor='pointer';\n      });\n      /* Click on track to scrub */\n      container.querySelector('.ev-cctv-track')