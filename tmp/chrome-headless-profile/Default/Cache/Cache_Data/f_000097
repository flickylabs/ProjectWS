══ */\n.changes-log{padding:8px 24px 14px}\n.changes-toggle{\n  display:flex;align-items:center;gap:8px;cursor:pointer;\n  font-size:12px;color:var(--t3);font-weight:500;padding:6px 0;\n  transition:color .15s;user-select:none;\n}\n.changes-toggle:hover{color:var(--t2)}\n.changes-dot{\n  width:7px;height:7px;border-radius:50%;background:var(--gold);\n  box-shadow:0 0 6px rgba(212,162,78,.4);flex-shrink:0;\n  transition:opacity .2s;\n}\n.changes-dot.read{opacity:0}\n.changes-toggle .cnt{font-size:11px;background:var(--p4);color:var(--t2);padding:1px 8px;border-radius:10px;font-weight:500}\n.changes-body{\n  max-height:0;overflow:hidden;transition:max-height .25s ease,opacity .2s ease;opacity:0;\n}\n.changes-body.open{max-height:200px;opacity:1}\n.changes-entry{\n  display:flex;align-items:center;gap:8px;padding:4px 0;\n  font-size:12px;color:var(--t3);line-height:1.5;\n}\n.changes-entry .ce-turn{color:var(--t2);font-weight:600;min-width:24px}\n.changes-entry .ce-action{color:var(--gold);font-weight:500}\n.changes-entry .ce-effect{color:var(--t2)}\n\n/* ── Tier 1: Minor Event Banner ── */\n.event-banner{\n  position:absolute;bottom:0;left:40px;right:40px;z-index:80;\n  height:60px;display:flex;align-items:center;\n  background:rgba(212,162,78,.08);border:1px solid var(--gold-bdr);border-left:4px solid var(--gold);\n  border-radius:var(--r-sm) var(--r-sm) 0 0;\n  padding:0 20px;gap:14px;\n  transform:translateY(100%);opacity:0;\n  transition:transform .35s cubic-bezier(.4,0,.2,1),opacity .3s ease;\n  pointer-events:none;\n}\n.event-banner.show{transform:translateY(0);opacity:1;pointer-events:auto}\n.event-banner.dismiss{transform:translateY(100%);opacity:0;pointer-events:none}\n.event-banner+.event-banner.show{bottom:64px}\n.eb-icon{font-size:22px;flex-shrink:0}\n.eb-text{flex:1;font-size:15px;color:var(--gold-l);font-weight:500}\n.eb-actions{display:flex;gap:8px}\n.eb-btn{\n  background:rgba(212,162,78,.12);border:1px solid var(--gold-bdr);color:var(--gold-l);\n  padding:5px 16px;border-radius:16px;font-size:13px;font-weight:600;\n  cursor:pointer;font-family:var(--font);transition:all .15s;\n}\n.eb-btn:hover{background:rgba(212,162,78,.25);border-color:var(--gold)}\n\n/* ── Tier 2: Chat-Inline Choice Card ── */\n.chat-choice-card{\n  align-self:center;width:min(480px,90%);\n  background:var(--p2);border:2px solid var(--gold-bdr);border-radius:var(--r);\n  padding:18px 24px;margin:8px 0;\n  display:flex;flex-direction:column;align-items:center;gap:14px;\n  animation:choiceIn .4s ease;\n}\n@keyframes choiceIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}\n.ccc-icon{font-size:24px}\n.ccc-text{font-size:16px;color:var(--t1);font-weight:500;text-align:center;line-height:1.6}\n.ccc-actions{display:flex;gap:12px}\n.choice-btn{\n  background:rgba(212,162,78,.08);border:2px solid var(--gold-bdr);color:var(--gold-l);\n  padding:8px 24px;border-radius:var(--r-sm);font-size:15px;font-weight:600;\n  cursor:pointer;font-family:var(--font);transition:all .2s;\n}\n.choice-btn:hover{background:rgba(212,162,78,.2);border-color:var(--gold);box-shadow:0 0 12px rgba(212,162,78,.15)}\n.chat-choice-card.chosen{opacity:.5;pointer-events:none}\n.chat-choice-card.chosen .choice-btn{opacity:.4;border-color:var(--p5);color:var(--t3);background:transparent}\n.chat-choice-card.chosen .choice-btn.selected{opacity:1;color:var(--green);border-color:rgba(92,201,122,.3);background:rgba(92,201,122,.06)}\n.chat-choice-card.chosen .choice-btn.selected::before{content:'✓ ';font-weight:700}\n\n/* ═══ Verdict 2-Step ═══ */\n.verdict-step-1,.verdict-step-2{\n  display:flex;flex-direction:column;align-items:center;gap:36px;\n  width:100%;max-width:860px;transition:opacity .25s ease;\n}\n.verdict-step-2{display:none}\n.verdict-step-1.hidden{display:none}\n.verdict-step-2.active{display:flex;animation:msgIn .3s ease}\n.verdict-next-btn,.verdict-back-btn{\n  padding:12px 36px;border-radius:12px;\n  font-size:16px;font-weight:700;cursor:po