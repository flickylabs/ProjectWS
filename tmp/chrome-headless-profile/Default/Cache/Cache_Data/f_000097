* Slider */\n.verdict-slider-wrap{width:100%;display:flex;flex-direction:column;align-items:center;gap:8px}\n.verdict-slider{\n  -webkit-appearance:none;appearance:none;\n  width:100%;max-width:440px;height:8px;\n  background:linear-gradient(90deg,var(--blue) 0%,var(--p4) 50%,var(--red) 100%);\n  border-radius:4px;outline:none;cursor:pointer;\n}\n.verdict-slider::-webkit-slider-thumb{\n  -webkit-appearance:none;appearance:none;\n  width:22px;height:22px;border-radius:50%;\n  background:var(--gold);border:3px solid var(--gold-d);\n  cursor:pointer;box-shadow:0 0 12px rgba(212,162,78,.4);\n  transition:box-shadow .15s;\n}\n.verdict-slider::-webkit-slider-thumb:hover{box-shadow:0 0 18px rgba(212,162,78,.6)}\n.verdict-slider::-moz-range-thumb{\n  width:22px;height:22px;border-radius:50%;\n  background:var(--gold);border:3px solid var(--gold-d);\n  cursor:pointer;box-shadow:0 0 12px rgba(212,162,78,.4);\n}\n.verdict-slider::-moz-range-track{height:8px;background:linear-gradient(90deg,var(--blue),var(--p4),var(--red));border-radius:4px;border:none}\n.verdict-slider-label{font-size:12px;color:var(--t3);font-weight:500}\n\n/* ── Section 2: Solution Cards ── */\n.verdict-solutions{\n  display:flex;gap:20px;width:100%;max-width:800px;justify-content:center;\n}\n.verdict-card{\n  flex:1;max-width:240px;\n  display:flex;flex-direction:column;align-items:center;gap:12px;\n  padding:28px 20px 22px;border-radius:16px;\n  background:var(--p2);border:2px solid rgba(255,255,255,.06);\n  cursor:pointer;transition:all .25s;text-align:center;\n}\n.verdict-card:hover{\n  transform:translateY(-6px);\n  border-color:rgba(255,255,255,.12);\n  box-shadow:0 8px 32px rgba(0,0,0,.4);\n}\n.verdict-card.selected{\n  border-color:var(--gold);\n  box-shadow:0 0 24px rgba(212,162,78,.2),0 0 8px rgba(212,162,78,.1) inset;\n}\n.verdict-card-icon{width:36px;height:36px;color:var(--t2);transition:color .2s}\n.verdict-card.selected .verdict-card-icon{color:var(--gold)}\n.verdict-card-title{font-size:18px;font-weight:700;color:var(--t1)}\n.verdict-card-summary{font-size:14px;color:var(--t3);line-height:1.5}\n.verdict-card-btn{\n  margin-top:auto;padding:8px 24px;border-radius:8px;\n  background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);\n  color:var(--t2);font-size:14px;font-weight:600;\n  cursor:pointer;font-family:var(--font);transition:all .2s;\n}\n.verdict-card-btn:hover{background:rgba(255,255,255,.08);color:var(--t1)}\n.verdict-card.selected .verdict-card-btn{\n  background:var(--gold);border-color:var(--gold);color:var(--bg);\n  box-shadow:0 0 12px rgba(212,162,78,.3);\n}\n\n/* ═══ Feature 12: Focus Mode ═══ */\n/* Grid overrides */\n.app.left-collapsed{grid-template-columns:40px 1fr 380px}\n.app.right-collapsed{grid-template-columns:400px 1fr 40px}\n.app.both-collapsed{grid-template-columns:40px 1fr 40px}\n\n/* Panel transition */\n.panel-l,.panel-r{transition:width .3s ease,min-width .3s ease}\n\n/* Collapsed panel content hiding */\n.panel-l.collapsed>.sec,.panel-r.collapsed>.sec{\n  overflow:hidden;opacity:0;pointer-events:none;\n  max-height:0;padding:0;margin:0;border:none;\n  transition:opacity .2s ease,max-height .2s ease,padding .2s ease;\n}\n.panel-l>.sec,.panel-r>.sec{\n  transition:opacity .2s ease .1s,max-height .3s ease,padding .2s ease;\n}\n\n/* Panel strip (collapsed indicator) */\n.panel-strip{\n  display:none;flex-direction:column;align-items:center;justify-content:center;\n  gap:12px;padding:16px 0;cursor:pointer;height:100%;min-height:0;\n}\n.panel-l.collapsed .panel-strip,.panel-r.collapsed .panel-strip{display:flex}\n\n.panel-strip-label{\n  writing-mode:vertical-rl;text-orientation:mixed;\n  font-size:12px;color:var(--t3);letter-spacing:.08em;font-weight:500;\n  white-space:nowrap;\n}\n.panel-strip-arrow{\n  font-size:16px;color:var(--t3);transition:color .15s;\n}\n.panel-strip:hover .panel-strip-arrow{color:var(--gold)}\n.panel-strip:hover .panel-strip-label{color:var(--t2)}\n.panel-strip-icon{color:var(--t3);transit