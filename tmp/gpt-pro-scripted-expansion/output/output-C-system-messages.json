            "counterpartyRef:none",
            "counterpartyRefState:none",
            "context:interrogation",
            "eventType:stalemate_warning",
            "mentionTarget:ui_state",
            "emotion:neutral",
            "continuity:system",
            "disclosure:open",
            "revealGuard:open",
            "responseMode:system_notice",
            "reveal:full"
