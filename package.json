{
  "name": "solomon-init",
  "private": true,
  "version": "0.0.0",
  "description": "Project_Solomon Steam PC build",
  "author": "FLICKY LABS INC",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --force && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:pc": "vite --config vite.config.pc.ts",
    "build:pc": "tsc -b --force && vite build --config vite.config.pc.ts",
    "steam:appid": "node scripts/write-steam-appid.mjs",
    "steam:secret": "node scripts/generate-session-secret.mjs",
    "server:env": "node scripts/verify-server-env.mjs",
    "server:smoke": "node scripts/smoke-server.mjs",
    "railway:smoke": "node scripts/smoke-railway.mjs",
    "steam:auth:mock": "node scripts/verify-steam-auth.mjs",
    "electron:dev": "npm run steam:appid && electron electron/main.cjs --dev",
    "steam:run": "npm run build:pc && npm run steam:appid && electron electron/main.cjs",
    "steam:dir": "npm run build:pc && electron-builder --dir --config electron-builder.json",
    "steam:dir:release": "node scripts/verify-release-api-url.mjs && npm run steam:dir && node scripts/verify-steam-release.mjs",
    "steam:package": "npm run build:pc && electron-builder --config electron-builder.json",
    "steam:package:release": "node scripts/verify-release-api-url.mjs && npm run steam:package",
    "steam:stage:windows": "npm run steam:dir:release && node scripts/stage-steam-depot.mjs",
    "steam:ready": "npm run server:env && npm run server:smoke && npm run check:all && npm run steam:stage:windows",
    "qa:gate": "node scripts/qa-runtime-gate.cjs",
    "qa:route": "node scripts/qa-route-simulator.cjs",
    "qa:route:exhaustive": "node scripts/qa-route-simulator.cjs --exhaustive --max-depth=5 --max-states=240 --max-routes=480 --max-actions-per-state=36 --fail-on-hard",
    "qa:browser": "node scripts/qa-browser-harness.cjs",
    "qa:fast": "node scripts/qa-fast.cjs",
    "qa:free-interrogation": "node --experimental-strip-types scripts/qa-free-interrogation-policy.mjs",
    "qa:deep": "node scripts/qa-deep.cjs",
    "qa:visual": "node scripts/qa-visual-report.cjs",
    "check:policy": "npm run qa:free-interrogation",
    "check:sync": "npm run qa:fast",
    "check:all": "npm run qa:fast && npm run qa:free-interrogation",
    "server": "cd server && node index.js",
    "server:dev": "cd server && node --watch index.js",
    "server:seed": "cd server && node db/seed.js"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "steamworks.js": "^0.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
