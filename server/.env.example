PORT=3001

# Required for live Steam Web API authentication.
STEAM_APP_ID=4709340
STEAM_AUTH_IDENTITY=solomon-web-api
STEAM_WEB_API_KEY=replace-with-publisher-web-api-key
STEAM_SESSION_SECRET=replace-with-long-random-secret
STEAM_ACHIEVEMENT_IDS=ACH_FIRST_CASE_CLEARED,ACH_PERFECT_VERDICT,ACH_TRUTH_BREAKTHROUGH,ACH_EVIDENCE_MASTER,ACH_MEDIATION_SUCCESS,ACH_NO_HINT_CLEAR,ACH_ALL_BASE_CASES_CLEARED,ACH_JUDGE_LEVEL_10,ACH_STREAK_7_DAYS,ACH_STEAM_DECK_SESSION
STEAM_REQUIRE_API_AUTH=1

# Telemetry. The client sends only anon_id plus structured event IDs.
TELEMETRY_ENABLED=true
TELEMETRY_ALLOWED_ORIGINS=file://,app://.

# Local development only. Must be 0 or unset in production.
STEAM_AUTH_MOCK=0
STEAM_AUTH_MOCK_STEAM_ID=76561198000000000

# Required by /api/llm/* proxy routes.
OPENAI_API_KEY=replace-with-openai-api-key
