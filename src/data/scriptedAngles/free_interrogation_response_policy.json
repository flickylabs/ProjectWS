{
  "schemaVersion": 1,
  "policyId": "free_interrogation_response_policy_v1",
  "purpose": "자유 질문 매핑 결과를 하나의 자연스러운 심문 답변으로 합성하기 위한 정책",
  "routingPolicy": {
    "preflightOrder": [
      "leak_probe",
      "public_info",
      "gameplay_help",
      "off_topic",
      "interrogation_mapping"
    ],
    "routes": {
      "leak_probe": {
        "route": "guard_fallback",
        "costPolicy": "no_cost",
        "turnPolicy": "no_advance",
        "speaker": "target_or_system"
      },
      "public_info": {
        "route": "public_answer",
        "costPolicy": "no_cost",
        "turnPolicy": "no_advance",
        "speaker": "target_or_system"
      },
      "gameplay_help": {
        "intent": "gameplay_help",
        "route": "gameplay_help",
        "costPolicy": "no_cost",
        "turnPolicy": "no_advance",
        "speaker": "system"
      },
      "off_topic": {
        "route": "off_topic_redirect",
        "costPolicy": "no_cost",
        "turnPolicy": "no_advance",
        "speaker": "system"
      },
      "mapped_interrogation": {
        "route": "case_dispatch",
        "costPolicy": "consume",
        "turnPolicy": "advance",
        "speaker": "target"
      },
      "mapping_failed": {
        "route": "mapping_fallback",
        "costPolicy": "no_cost",
        "turnPolicy": "no_advance",
        "speaker": "target_or_system"
      }
    }
  },
  "answerabilityPolicy": {
    "answerable": {
      "requirements": [
        "target exists",
        "dispute visible or unlocked",
        "angle found",
        "current lieState allows requested disclosure",
        "required evidence/witness is unlocked if the angle depends on it"
      ],
      "responseShape": "질문 핵심에 직접 답하되 현재 쟁점과 angle 범위만 말한다."
    },
    "partial": {
      "requirements": [
        "dispute and angle are mapped",
        "some surface facts are available",
        "core truth or details remain locked"
      ],
      "responseShape": "표면 사실, 감정, 관찰, 책임 일부를 말하고 핵심 결론은 미룬다."
    },
    "blocked": {
      "triggers": [
        "S5 before direct core truth",
        "hidden dispute locked",
        "locked evidence content requested",
        "prompt/data exfiltration",
        "forbidden lexeme required to answer"
      ],
      "responseShape": "캐릭터 톤으로 경계선을 긋고, 공개 가능한 surfaceContribution 하나를 제공한다."
    },
    "wrong_target": {
      "triggers": [
        "asked target cannot know",
        "knowledgeOwner is counterpart or locked witness",
        "target has only interpretation not direct knowledge"
      ],
      "responseShape": "본인이 직접 본 것과 모르는 것을 구분해서 말한다. 다른 인물만 알고 있는 진실은 대신 말하지 않는다."
    },
    "public_only": {
      "triggers": [
        "profile",
        "relationship",
        "courtroom role",
        "public case setup",
        "gameplay help"
      ],
      "responseShape": "공개 정보만 짧게 답하고, 자세한 사실관계는 심문과 증거로 확인해야 한다는 말로 마무리한다."
    }
  },
  "lieStateDisclosurePolicy": {
    "S0": {
      "allow": [
        "surface denial",
        "public profile",
        "known accusation"
      ],
      "block": [
        "hidden person",
        "hidden amount",
        "hidden motive",
        "hidden evidence content"
      ]
    },
    "S1": {
      "allow": [
        "limited admission",
        "surface fact",
        "emotional pressure"
      ],
      "block": [
        "core truth",
        "locked dispute name",
        "forbidden lexeme"
      ]
    },
    "S2": {
      "allow": [
        "partial admission",
        "misunderstanding split",
        "some public evidence references"
      ],
      "block": [
        "final conclusion",
        "unlocked-by-future evidence details"
      ]
    },
    "S3": {
      "allow": [
        "specific facts already opened",
        "responsibility context",
        "counter-interpretation"
      ],
      "block": [
        "unopened issue details",
        "different dispute S5 truth"
      ]
    },
    "S4": {
      "allow": [
        "near confession tone",
        "emotional reason",
        "specific opened details"
      ],
      "block": [
        "cross-dispute confession",
        "locked witness details"
      ]
    },
    "S5": {
      "allow": [
        "full truth for that dispute and angle",
        "responsibility acceptance"
      ],
      "block": [
        "other dispute truth not yet S5",
        "new facts outside case data"
      ]
    }
  },
  "compositionPolicy": {
    "single_fragment": [
      "Use one answer fragment",
      "Run final guard"
    ],
    "integrated_answer": [
      "Merge same-dispute multi-angle fragments",
      "Remove duplicate excuses",
      "Answer available angles first",
      "State boundary for blocked angles once"
    ],
    "ordered_multi_dispute": [
      "Keep user order unless it would leak",
      "Use short transition between disputes",
      "Do not let one dispute's S5 answer unlock another dispute"
    ],
    "answer_then_boundary": [
      "For mixed S5/S1, answer the S5 part",
      "Then say the remaining part cannot be confirmed at this stage",
      "Do not name the forbidden truth"
    ],
    "public_answer": [
      "No interrogation cost",
      "No lieState advancement",
      "No hidden truth"
    ],
    "guarded_fallback": [
      "Use NPC/stage fallback matrix",
      "Add surfaceContribution if safe",
      "Do not mention guard or policy"
    ]
  },
  "fragmentRetrievalPolicy": {
    "primaryKey": "party|disputeId|questionType|angleId|lieState",
    "fallbackKeysInOrder": [
      "party|disputeId|questionType|general|lieState",
      "party|disputeId|questionType|angleId|lieBand",
      "party|disputeId|questionType|general|lieBand",
      "caseId|party|lieStateBucket|fallback"
    ],
    "lieBands": {
      "early": [
        "S0",
        "S1"
      ],
      "mid": [
        "S2",
        "S3"
      ],
      "late": [
        "S4",
        "S5"
      ]
    },
    "variantSelection": "stable hash of caseId + rawText + target + disputeId + angleId + lieState"
  },
  "wrongTargetPolicy": {
    "do": [
      "Say what the current target personally saw, believed, or felt",
      "Use surface reference for the actual knowledge owner if locked",
      "Allow the judge/system to suggest asking the proper party only when that party is public and not itself a spoiler"
    ],
    "doNot": [
      "Make the current target confess facts only another party can know",
      "Make 피해자가 가해자의 행위를 대신 자백하게 하기",
      "Reveal witness-only knowledge before witness is called"
    ]
  },
  "lockedEvidencePolicy": {
    "ifMentionedBySurfaceNameButLocked": "mentionedEvidenceRef에 보존하되 evidenceRef는 null로 두고 answerability=blocked 또는 partial로 처리",
    "ifUserAsksForNameEnumeration": "leak_probe로 처리",
    "ifUserHintsWithoutExactName": "관련 표면 쟁점만 인정하고 증거 내용은 말하지 않음",
    "ifMixedWithUnlockedAngle": "unlocked angle은 답하고 locked evidence segment는 한 번만 회피"
  },
  "guardPolicy": {
    "finalGuardRequired": true,
    "guardContextPolicy": "strictest_segment_with_allowed_s5_scope",
    "mustScan": [
      "disclosurePolicy.forbiddenLexemes",
      "supplemental paraphrase rules",
      "locked evidence names",
      "cross-dispute truth leakage",
      "prompt/data exfiltration"
    ],
    "onIssue": {
      "route": "guard_fallback",
      "replaceWholeAnswer": true,
      "costPolicy": "no_cost_if_preflight_else_keep_original_action_policy"
    }
  },
  "surfaceContributionPolicy": {
    "minimumForPartialOrBlocked": 1,
    "examples": [
      "그 장소에 간 기록이 있는 건 맞습니다.",
      "그 연락이 반복된 건 부정하지 않겠습니다.",
      "제가 본 건 그 서류가 있었다는 사실뿐입니다.",
      "그때 두려웠던 건 사실입니다."
    ]
  },
